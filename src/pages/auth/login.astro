---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
---

<MainLayout
  title="Masuk"
  description="Masuk untuk nikmati kemudahan berdonasi dan akses fitur lainnya di Beramalbersama."
>
  <Header type="notshare" text="Login" />

  <div
    class="container min-h-screen bg-neutral-50 flex flex-col justify-center"
  >
    <div class="px-8">
      <!-- Logo -->
      <div class="flex flex-col items-center text-center mb-8">
        <div class="w-auto h-16 mb-6">
          <Image
            src="/assets/logo/logo-short-color.png"
            alt="logo"
            width={64}
            height={64}
            class="w-full h-full object-contain"
          />
        </div>
        <h1 class="text-lg font-semibold text-gray-800 leading-snug">
          Setiap Donasi Adalah<br />Langkah Kebaikan
        </h1>
      </div>

      {/* Alert error — hidden by default, ditampilkan via JS */}
      <div
        id="login-error"
        class="hidden items-center gap-2 bg-red-50 border border-red-200 text-red-600 text-xs rounded-2xl px-4 py-3 mb-4"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"></path>
        </svg>
        <span id="login-error-text">Nomor Telepon atau Password Anda Salah</span
        >
      </div>

      <form id="login-form" class="space-y-4" novalidate>
        {/* Telepon */}
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
          </span>
          <input
            id="phone"
            name="phone"
            type="text"
            placeholder="Nomor telepon"
            autocomplete="username"
            class="w-full pl-14 pr-5 py-4 bg-gray-100 border border-transparent rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-primary-400 focus:bg-white transition-colors"
          />
        </div>

        {/* Password */}
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
          </span>
          <input
            id="password"
            name="password"
            type="password"
            placeholder="Password"
            autocomplete="current-password"
            class="w-full pl-14 pr-12 py-4 bg-gray-100 border border-transparent rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-primary-400 focus:bg-white transition-colors"
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
            aria-label="Tampilkan password"
          >
            <svg
              id="eye-off-icon"
              class="w-5 h-5 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
            <svg
              id="eye-icon"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
              ></path>
            </svg>
          </button>
        </div>

        {/* Lupa password */}
        <div class="flex justify-end px-2">
          <a
            href="/auth/forgot-password"
            class="text-xs font-medium text-primary-600
          hover:text-primary-700 hover:underline"
          >
            Lupa Password?
          </a>
        </div>

        {/* Submit */}
        <button
          id="btn-login"
          type="submit"
          class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-4 rounded-full transition-all duration-150 mt-2"
        >
          Masuk
        </button>
      </form>

      {/* Daftar */}
      <p class="text-xs text-center text-gray-500 mt-6">
        Belum punya akun?{" "}
        <a
          href="/auth/register"
          class="font-semibold text-primary-600 hover:underline"
        >
          Daftar disini
        </a>
      </p>
    </div>
  </div>

  <script>
    import { showToast } from "@/lib/toast";
    import { setToken, isLoggedIn } from "@/lib/auth";
    import { useApi } from "@/lib/api";

    if (isLoggedIn()) {
      const params = new URLSearchParams(window.location.search);
      window.location.replace(params.get("from") ?? "/");
    }

    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById("login-form") as HTMLFormElement;
      const btnLogin = document.getElementById(
        "btn-login",
      ) as HTMLButtonElement;
      const errorBox = document.getElementById("login-error") as HTMLElement;
      const errorText = document.getElementById(
        "login-error-text",
      ) as HTMLElement;
      const toggleBtn = document.getElementById(
        "toggle-password",
      ) as HTMLButtonElement;
      const passwordInput = document.getElementById(
        "password",
      ) as HTMLInputElement;
      const eyeIcon = document.getElementById("eye-icon") as HTMLElement;
      const eyeOffIcon = document.getElementById("eye-off-icon") as HTMLElement;

      toggleBtn.addEventListener("click", () => {
        const isHidden = passwordInput.type === "password";
        passwordInput.type = isHidden ? "text" : "password";
        eyeIcon.classList.toggle("hidden", isHidden);
        eyeOffIcon.classList.toggle("hidden", !isHidden);
      });

      function showError(msg: string) {
        errorText.textContent = msg;
        errorBox.classList.remove("hidden");
        errorBox.classList.add("flex");
      }

      function hideError() {
        errorBox.classList.add("hidden");
        errorBox.classList.remove("flex");
      }

      function setLoading(loading: boolean) {
        btnLogin.disabled = loading;
        btnLogin.textContent = loading ? "Memuat..." : "Masuk";
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        hideError();

        const phoneInput = (
          document.getElementById("phone") as HTMLInputElement
        ).value.trim();
        const password = passwordInput.value;

        const phone = phoneInput.startsWith("0")
          ? phoneInput.slice(1)
          : phoneInput;

        if (!phone || !password) {
          showToast("Masukkan telepon dan password", "error");
          return;
        }

        setLoading(true);
        try {
          const { data } = await useApi().post("/auth/login", {
            phone,
            password,
          });
          const token = data?.access_token;
          if (!token) throw new Error("Token tidak ditemukan");

          setToken(token);
          const params = new URLSearchParams(window.location.search);
          window.location.href = params.get("from") ?? "/";
        } catch (err: any) {
          if (err?.status === 429 || err?.response?.status === 429) {
            showError(
              "Terlalu banyak percobaan. Silakan coba lagi beberapa saat lagi.",
            );
          } else {
            showError(err.message ?? "Nomor Telepon atau Password Anda Salah");
          }
        } finally {
          setLoading(false);
        }
      });
    });
  </script>
</MainLayout>
