---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
---

<MainLayout
  title="Atur Password"
  description="Buat password untuk mengamankan akun Anda."
>
  <Header type="notshare" text="Atur Password" link="/auth/otp" />

  <div
    class="container min-h-screen bg-neutral-50 flex flex-col justify-center"
  >
    <div class="px-8">
      <!-- Logo -->
      <div class="flex flex-col items-center text-center mb-8">
        <div class="w-auto h-16 mb-6">
          <Image
            src="/assets/logo/logo-short-color.png"
            alt="logo"
            width={64}
            height={64}
            class="w-full h-full object-contain"
          />
        </div>
        <h1 class="text-lg font-semibold text-gray-800 leading-snug">
          Buat Password<br />Baru
        </h1>
        <p class="text-xs text-gray-400 mt-2">
          Password digunakan untuk masuk ke akun
          <span id="display-phone" class="font-semibold text-gray-600"></span>
        </p>
      </div>

      {/* Alert error — hidden by default, ditampilkan via JS */}
      <div
        id="setpass-error"
        class="hidden items-center gap-2 bg-red-50 border border-red-200 text-red-600 text-xs rounded-2xl px-4 py-3 mb-4"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"></path>
        </svg>
        <span id="setpass-error-text">Terjadi kesalahan</span>
      </div>

      <div class="space-y-4">
        {/* Password */}
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
          </span>
          <input
            id="input-password"
            type="password"
            placeholder="Password baru"
            autocomplete="new-password"
            class="w-full pl-14 pr-12 py-4 bg-gray-100 border border-transparent rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-primary-400 focus:bg-white transition-colors"
          />
          <button
            type="button"
            id="toggle-password"
            aria-label="Tampilkan password"
            class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors"
          >
            <!-- Eye icon (default: tampil saat password tersembunyi) -->
            <svg
              id="eye-icon"
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
            <!-- Eye-off icon (tampil saat password terlihat) -->
            <svg
              id="eye-off-icon"
              class="w-5 h-5 hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
              ></path>
            </svg>
          </button>
        </div>

        <!-- Password strength indicator -->
        <div id="strength-bar-wrapper" class="hidden px-2 space-y-1">
          <div class="flex gap-1">
            <div
              id="bar-1"
              class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
            >
            </div>
            <div
              id="bar-2"
              class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
            >
            </div>
            <div
              id="bar-3"
              class="h-1 flex-1 rounded-full bg-gray-200 transition-colors"
            >
            </div>
          </div>
          <p id="strength-label" class="text-[11px] text-gray-400"></p>
        </div>

        {/* Konfirmasi Password */}
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"
              ></path>
            </svg>
          </span>
          <input
            id="input-password-confirm"
            type="password"
            placeholder="Ulangi password"
            autocomplete="new-password"
            class="w-full pl-14 pr-12 py-4 bg-gray-100 border border-transparent rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-primary-400 focus:bg-white transition-colors"
          />
          <!-- Match indicator -->
          <span
            id="match-icon"
            class="absolute right-5 top-1/2 -translate-y-1/2 hidden"
            aria-hidden="true"></span>
        </div>
        <p id="match-hint" class="hidden text-[11px] text-red-400 px-2">
          Password tidak cocok
        </p>

        <!-- Syarat password -->
        <ul class="space-y-1 text-[11px] text-gray-400 px-2">
          <li id="rule-length" class="flex items-center gap-1.5">
            <span class="rule-dot w-1.5 h-1.5 rounded-full bg-gray-300 shrink-0"
            ></span>
            Minimal 6 karakter
          </li>
        </ul>

        {/* Submit */}
        <button
          id="btn-setpass"
          type="button"
          class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-4 rounded-full transition-all duration-150 mt-2"
        >
          Selanjutnya
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";
  import { useApi } from "@/lib/api";

  document.addEventListener("DOMContentLoaded", () => {
    // ── Elemen ──────────────────────────────────────────────────────────────
    const btnSetpass = document.getElementById(
      "btn-setpass",
    ) as HTMLButtonElement;
    const inputPassword = document.getElementById(
      "input-password",
    ) as HTMLInputElement;
    const inputConfirm = document.getElementById(
      "input-password-confirm",
    ) as HTMLInputElement;
    const toggleBtn = document.getElementById(
      "toggle-password",
    ) as HTMLButtonElement;
    const eyeIcon = document.getElementById("eye-icon") as HTMLElement;
    const eyeOffIcon = document.getElementById("eye-off-icon") as HTMLElement;
    const errorBox = document.getElementById("setpass-error") as HTMLElement;
    const errorText = document.getElementById(
      "setpass-error-text",
    ) as HTMLElement;
    const displayPhone = document.getElementById(
      "display-phone",
    ) as HTMLElement;
    const matchIcon = document.getElementById("match-icon") as HTMLElement;
    const matchHint = document.getElementById("match-hint") as HTMLElement;
    const strengthWrapper = document.getElementById(
      "strength-bar-wrapper",
    ) as HTMLElement;
    const bar1 = document.getElementById("bar-1") as HTMLElement;
    const bar2 = document.getElementById("bar-2") as HTMLElement;
    const bar3 = document.getElementById("bar-3") as HTMLElement;
    const strengthLabel = document.getElementById(
      "strength-label",
    ) as HTMLElement;
    const ruleLength = document.getElementById("rule-length") as HTMLElement;

    // ── Baca phone & guard auth ─────────────────────────────────────────────
    const getCookie = (name: string) =>
      document.cookie
        .split("; ")
        .find((r) => r.startsWith(`${name}=`))
        ?.split("=")[1];

    // Redirect jika sudah login
    const authToken = getCookie("authToken");
    if (authToken) {
      window.location.href = "/";
      return;
    }

    // Redirect jika tidak ada phone cookie
    const phone = getCookie("authphone");
    const decodedPhone = phone ? decodeURIComponent(phone) : "";
    if (!decodedPhone) {
      window.location.href = "/auth/forgot-password";
      return;
    }

    displayPhone.textContent = decodedPhone;

    // ── Helpers ─────────────────────────────────────────────────────────────
    function showError(msg: string) {
      errorText.textContent = msg;
      errorBox.classList.remove("hidden");
      errorBox.classList.add("flex");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function hideError() {
      errorBox.classList.add("hidden");
      errorBox.classList.remove("flex");
    }

    function setLoading(state: boolean) {
      btnSetpass.disabled = state;
      btnSetpass.textContent = state ? "Memproses..." : "Selanjutnya";
    }

    // ── Toggle visibility (berlaku untuk kedua input) ────────────────────────
    let passwordVisible = false;

    toggleBtn.addEventListener("click", () => {
      passwordVisible = !passwordVisible;
      const type = passwordVisible ? "text" : "password";
      inputPassword.type = type;
      inputConfirm.type = type;
      eyeIcon.classList.toggle("hidden", passwordVisible);
      eyeOffIcon.classList.toggle("hidden", !passwordVisible);
    });

    // ── Match indicator ─────────────────────────────────────────────────────
    function validateMatch() {
      const pass = inputPassword.value;
      const confirm = inputConfirm.value;

      if (!confirm) {
        matchIcon.classList.add("hidden");
        matchHint.classList.add("hidden");
        inputConfirm.classList.remove("border-red-300", "border-primary-400");
        return;
      }

      const isMatch = pass === confirm;

      matchIcon.classList.remove("hidden");
      matchIcon.textContent = isMatch ? "✓" : "✗";
      matchIcon.className = `absolute right-5 top-1/2 -translate-y-1/2 text-sm font-bold ${isMatch ? "text-primary-500" : "text-red-400"}`;

      matchHint.classList.toggle("hidden", isMatch);
      inputConfirm.classList.toggle("border-primary-400", isMatch);
      inputConfirm.classList.toggle("border-red-300", !isMatch);
    }

    inputConfirm.addEventListener("input", validateMatch);

    // ── Password strength ────────────────────────────────────────────────────
    function getStrengthLevel(pass: string): 0 | 1 | 2 | 3 {
      if (!pass) return 0;
      let score = 0;
      if (pass.length >= 6) score++;
      if (/[A-Za-z]/.test(pass) && /[0-9]/.test(pass)) score++;
      if (pass.length >= 10 || /[^A-Za-z0-9]/.test(pass)) score++;
      return Math.min(score, 3) as 0 | 1 | 2 | 3;
    }

    function updateStrength(pass: string) {
      if (!pass) {
        strengthWrapper.classList.add("hidden");
        return;
      }
      strengthWrapper.classList.remove("hidden");

      const level = getStrengthLevel(pass);
      const barColor = [
        "bg-gray-200",
        "bg-red-400",
        "bg-yellow-400",
        "bg-primary-500",
      ][level];
      const labels = ["", "Lemah", "Sedang", "Kuat"];
      const labelClass = [
        "",
        "text-red-400",
        "text-yellow-500",
        "text-primary-500",
      ][level];

      [bar1, bar2, bar3].forEach((bar, i) => {
        bar.className = `h-1 flex-1 rounded-full transition-colors ${i < level ? barColor : "bg-gray-200"}`;
      });

      strengthLabel.textContent = labels[level];
      strengthLabel.className = `text-[11px] ${labelClass}`;

      const ruleDot = ruleLength.querySelector(".rule-dot") as HTMLElement;
      if (pass.length >= 6) {
        ruleDot?.classList.replace("bg-gray-300", "bg-primary-500");
        ruleLength.classList.replace("text-gray-400", "text-primary-600");
      } else {
        ruleDot?.classList.replace("bg-primary-500", "bg-gray-300");
        ruleLength.classList.replace("text-primary-600", "text-gray-400");
      }
    }

    inputPassword.addEventListener("input", () => {
      updateStrength(inputPassword.value);
      if (inputConfirm.value) validateMatch();
    });

    // ── Submit ──────────────────────────────────────────────────────────────
    btnSetpass.addEventListener("click", async () => {
      hideError();

      const password = inputPassword.value;
      const passwordKonfirmasi = inputConfirm.value;

      if (!password || !passwordKonfirmasi) {
        showToast("Harap isi semua field password", "error");
        return;
      }

      if (password.length < 6) {
        showToast("Password harus memiliki minimal 6 karakter", "error");
        return;
      }

      if (password !== passwordKonfirmasi) {
        showToast("Password dan konfirmasi password tidak cocok", "error");
        return;
      }

      setLoading(true);

      try {
        await useApi().post("/auth/set-password", {
          phone: decodedPhone,
          password,
          password_confirmation: passwordKonfirmasi,
        });

        document.cookie =
          "authphone=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

        showToast("Password berhasil diatur!", "success");
        window.location.href = "/auth/login";
      } catch (err: any) {
        showError(err.message ?? "Terjadi kesalahan, coba lagi");
      } finally {
        setLoading(false);
      }
    });
  });
</script>
