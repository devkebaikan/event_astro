---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { Image } from "astro:assets";
---

<MainLayout title="Lupa Password" description="">
  <Header type="notshare" text="Lupa Password" />

  <div
    class="container min-h-screen bg-neutral-50 flex flex-col justify-center"
  >
    <div class="px-8">
      <!-- Logo -->
      <div class="flex flex-col items-center text-center mb-8">
        <div class="w-auto h-16 mb-6">
          <Image
            src="/assets/logo/logo-short-color.png"
            alt="logo"
            width={64}
            height={64}
            class="w-full h-full object-contain"
          />
        </div>
        <h1 class="text-lg font-semibold text-gray-800 leading-snug">
          Atur Ulang<br />Kata Sandi
        </h1>
        <p class="text-xs text-gray-400 mt-2">
          Masukkan no whatsapp akun Anda dan kami akan mengirimkan kode OTP
          untuk mengatur ulang kata sandi Anda
        </p>
      </div>

      {/* Alert error — hidden by default, ditampilkan via JS */}
      <div
        id="register-error"
        class="hidden items-center gap-2 bg-red-50 border border-red-200 text-red-600 text-xs rounded-2xl px-4 py-3 mb-4"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
            clip-rule="evenodd"></path>
        </svg>
        <span id="register-error-text">Terjadi kesalahan</span>
      </div>

      <div class="space-y-4">
        {/* Telepon */}
        <div class="relative">
          <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
            <svg
              class="w-5 h-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
          </span>
          <input
            id="input-phone"
            type="text"
            placeholder="Nomor telepon"
            class="w-full pl-14 pr-5 py-4 bg-gray-100 border border-transparent rounded-full text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:border-primary-400 focus:bg-white transition-colors"
          />
        </div>

        {/* recaptcha */}
        <div class="flex justify-center pt-1">
          <div id="recaptcha-container"></div>
        </div>

        <p class="text-xs text-center text-gray-400 leading-relaxed px-2">
          Dengan mendaftar berarti kamu setuju dengan&nbsp;
          <a href="/syarat-ketentuan" class="text-primary-600 font-medium">
            Syarat & Ketentuan
          </a>
          &nbsp;dan&nbsp;
          <a href="/syarat-ketentuan" class="text-primary-600 font-medium">
            Kebijakan Privasi
          </a>
          &nbsp;Beramalbersama.com
        </p>

        {/* Submit */}
        <button
          id="btn-register"
          type="button"
          class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-4 rounded-full transition-all duration-150 mt-2"
        >
          Kirim Kode
        </button>

        <p class="text-xs text-center text-gray-500 mt-2">
          Ingat password?{" "}
          <a
            href="/auth/login"
            class="font-semibold text-primary-600 hover:underline"
          >
            Login disini
          </a>
        </p>
      </div>
    </div>
  </div>

  <script
    is:inline
    src="https://www.google.com/recaptcha/api.js?render=explicit"
    async
    defer></script>

  <script>
    import { showToast } from "@/lib/toast";
    import { useApi } from "@/lib/api";
    import { isLoggedIn } from "@/lib/auth";

    if (isLoggedIn()) {
      window.location.replace("/");
    }

    const SITE_KEY = import.meta.env.PUBLIC_SITE_KEY_CAPTCHA;

    let captchaVerified = false;
    let captchaWidgetId: number | null = null;

    (window as any).onCaptchaVerified = () => {
      captchaVerified = true;
    };

    (window as any).onCaptchaExpired = () => {
      captchaVerified = false;
    };

    // window.load guarantees the async reCAPTCHA script has executed
    window.addEventListener("load", () => {
      const container = document.getElementById("recaptcha-container");
      if (!container || !(window as any).grecaptcha) return;

      captchaWidgetId = (window as any).grecaptcha.render(container, {
        sitekey: SITE_KEY,
        callback: (window as any).onCaptchaVerified,
        "expired-callback": (window as any).onCaptchaExpired,
      });
    });

    document.addEventListener("DOMContentLoaded", () => {
      const btnRegister = document.getElementById(
        "btn-register",
      ) as HTMLButtonElement;
      const inputPhone = document.getElementById(
        "input-phone",
      ) as HTMLInputElement;
      const errorBanner = document.getElementById(
        "register-error",
      ) as HTMLDivElement;
      const errorText = document.getElementById(
        "register-error-text",
      ) as HTMLElement;

      function showError(msg: string) {
        errorText.textContent = msg;
        errorBanner.classList.remove("hidden");
        errorBanner.classList.add("flex");
        window.scrollTo({ top: 0, behavior: "smooth" });
      }

      function hideError() {
        errorBanner.classList.add("hidden");
        errorBanner.classList.remove("flex");
      }

      function setLoading(state: boolean) {
        btnRegister.disabled = state;
        btnRegister.textContent = state ? "Memproses..." : "Kirim Kode";
      }

      btnRegister.addEventListener("click", async () => {
        hideError();

        const phone = inputPhone.value.trim();

        if (!phone) {
          showToast("Harap isi nomer telepon anda", "error");
          return;
        }

        if (!captchaVerified) {
          showToast("Harap verifikasi bahwa Anda bukan robot", "error");
          return;
        }

        const captchaToken = (window as any).grecaptcha?.getResponse(
          captchaWidgetId,
        );
        if (!captchaToken) {
          showToast("Gagal mendapatkan token ReCAPTCHA", "error");
          return;
        }

        setLoading(true);

        try {
          await useApi().post("/auth/otp", {
            phone,
            "g-recaptcha-response": captchaToken,
          });

          const expires = new Date(Date.now() + 86400 * 1000).toUTCString();
          document.cookie = `authphone=${encodeURIComponent(phone)}; expires=${expires}; path=/`;

          showToast("Request OTP berhasil!", "success");
          window.location.href = "/auth/otp";
        } catch (err: any) {
          const message = err?.message ?? "Terjadi kesalahan";
          showError(message);
          (window as any).grecaptcha?.reset(captchaWidgetId);
          captchaVerified = false;
        } finally {
          setLoading(false);
        }
      });
    });
  </script>
</MainLayout>
