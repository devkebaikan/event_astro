---
export const prerender = true;

import Header from "@/components/layouts/Header.astro";
import Footer from "@/components/layouts/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";

const bankAccounts = [
  {
    bank: "Bank BCA",
    logo: "/images/icons/akber-green.webp",
    accountName: "Yayasan Beramal Bersama",
    accountNumber: "1234567890",
    color: "bg-blue-50",
    borderColor: "border-blue-200",
    badge: "Rekening Utama",
    badgeColor: "bg-blue-100 text-blue-700",
  },
  {
    bank: "Bank Mandiri",
    logo: "/images/icons/akber-green.webp",
    accountName: "Yayasan Beramal Bersama",
    accountNumber: "0987654321",
    color: "bg-yellow-50",
    borderColor: "border-yellow-200",
    badge: null,
    badgeColor: "",
  },
  {
    bank: "Bank Syariah Indonesia (BSI)",
    logo: "/images/icons/akber-green.webp",
    accountName: "Yayasan Beramal Bersama",
    accountNumber: "1122334455",
    color: "bg-emerald-50",
    borderColor: "border-emerald-200",
    badge: "Rekening Syariah",
    badgeColor: "bg-emerald-100 text-emerald-700",
  },
  {
    bank: "Bank BNI",
    logo: "/images/icons/akber-green.webp",
    accountName: "Yayasan Beramal Bersama",
    accountNumber: "5566778899",
    color: "bg-orange-50",
    borderColor: "border-orange-200",
    badge: null,
    badgeColor: "",
  },
];
---

<MainLayout title="Rekening Donasi" description="Daftar rekening resmi Beramalbersama.com untuk menyalurkan donasi Anda.">
  <Header type="notshare" text="Rekening Donasi" />

  <div class="container mx-auto min-h-screen bg-neutral-50 pt-[65px]">

    <div class="px-4 py-6 space-y-4">

      <!-- Info Banner -->
      <div class="bg-primary-500 rounded-2xl p-4 text-white">
        <div class="flex items-start gap-3">
          <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold m-0">Rekening Resmi</p>
            <p class="text-xs text-white/80 m-0 mt-1 leading-relaxed">
              Pastikan transfer ke rekening di bawah ini. Konfirmasi donasi via WhatsApp kami setelah transfer.
            </p>
          </div>
        </div>
      </div>

      <!-- Account List -->
      <div class="space-y-3">
        {bankAccounts.map((acc) => (
          <div class={`bg-white rounded-2xl border ${acc.borderColor} shadow-sm overflow-hidden`}>
            <div class={`${acc.color} px-4 py-3 flex items-center justify-between`}>
              <span class="text-sm font-bold text-neutral-800">{acc.bank}</span>
              {acc.badge && (
                <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full ${acc.badgeColor}`}>
                  {acc.badge}
                </span>
              )}
            </div>
            <div class="px-4 py-4">
              <p class="text-[11px] text-neutral-400 m-0 uppercase tracking-wide">Nama Rekening</p>
              <p class="text-sm font-semibold text-neutral-800 m-0 mt-0.5">{acc.accountName}</p>

              <div class="mt-3 flex items-center justify-between">
                <div>
                  <p class="text-[11px] text-neutral-400 m-0 uppercase tracking-wide">No. Rekening</p>
                  <p class="text-lg font-bold text-neutral-900 m-0 tracking-wider font-mono">
                    {acc.accountNumber}
                  </p>
                </div>
                <button
                  class="copy-btn px-3 py-2 bg-primary-50 hover:bg-primary-100 text-primary-600 text-xs font-semibold rounded-xl flex items-center gap-1.5 transition-colors duration-200"
                  data-number={acc.accountNumber}
                  data-bank={acc.bank}
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  Salin
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Confirmation CTA -->
      <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 p-4">
        <div class="flex items-start gap-3">
          <div class="w-10 h-10 bg-green-50 rounded-full flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 2.078.535 4.077 1.567 5.843L0 24l6.335-1.652A11.953 11.953 0 0012.017 24c6.624 0 11.99-5.367 11.99-11.987C24.007 5.375 18.641.009 12.017 0z"/>
            </svg>
          </div>
          <div class="flex-1">
            <p class="text-sm font-semibold text-neutral-800 m-0">Sudah Transfer?</p>
            <p class="text-xs text-neutral-500 m-0 mt-0.5 leading-relaxed">
              Konfirmasi donasi Anda via WhatsApp dengan menyertakan bukti transfer dan nama rekening tujuan.
            </p>
            <a
              href="https://api.whatsapp.com/send?phone=6281912344745&text=Assalamu%27alaikum%2C%20saya%20ingin%20konfirmasi%20transfer%20donasi."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 mt-3 px-4 py-2 bg-green-500 hover:bg-green-600 text-white text-xs font-semibold rounded-xl transition-colors duration-200"
            >
              Konfirmasi via WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- QRIS -->
      <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden">
        <div class="px-4 py-3 border-b border-neutral-100">
          <h2 class="text-sm font-bold text-neutral-800 m-0">Scan QRIS</h2>
          <p class="text-[11px] text-neutral-400 m-0 mt-0.5">Bayar dari semua aplikasi dompet digital</p>
        </div>
        <div class="p-4 flex flex-col items-center gap-3">
          <img
            src="/images/banner/Qr-code-akber-2025.webp"
            alt="QRIS Beramalbersama"
            class="w-48 h-48 object-contain rounded-xl border border-neutral-100"
          />
          <p class="text-xs text-neutral-500 text-center m-0">
            Scan menggunakan GoPay, OVO, DANA, ShopeePay,<br />m-Banking, atau aplikasi QRIS lainnya
          </p>
        </div>
      </div>

    </div>

    <!-- Toast -->
    <div
      id="copy-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-neutral-800 text-white text-xs font-medium px-4 py-2.5 rounded-full shadow-lg opacity-0 transition-opacity duration-300 pointer-events-none z-50"
    >
      Nomor rekening disalin!
    </div>

    <Footer />
  </div>
</MainLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const number = btn.dataset.number ?? "";
      navigator.clipboard.writeText(number).then(() => {
        const toast = document.getElementById("copy-toast");
        if (!toast) return;
        toast.style.opacity = "1";
        setTimeout(() => { toast.style.opacity = "0"; }, 2000);
      });
    });
  });
</script>
