---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";

import MainLayout from "@/layouts/MainLayout.astro";
// import { getAuthToken } from "@/lib/auth";
// import { getMyAccount } from "@/lib/FetchData";
import { formatRupiah, getInitialName } from "@/lib/formatter";

// ── Auth check server-side ───────────────────────────────────────────────────
// const token = getAuthToken(Astro.cookies);
// const isAuthenticated = !!token;
const isAuthenticated = true;

// ── Fetch data profil (hanya jika sudah login) ───────────────────────────────
let user: any = null;
let wallet: number | null = null;
let fetchError = false;

// if (isAuthenticated) {
//   try {
//     const res = await getMyAccount(token);
//     user   = res?.data ?? null;
//     wallet = res?.data?.dompet_kebaikan?.saldo ?? null;
//   } catch {
//     fetchError = true;
//   }
// }

const personalMenus = [
  { href: "/profil",      label: "Ubah Data Akun",              color: "blue",   icon: "user"        },
  { href: "/donasi-saya", label: "Donasi Saya",                 color: "green",  icon: "archive"     },
  { href: "/donasi-rutin",  label: "Rutin Saya",                  color: "purple", icon: "calendar"    },
  { href: "/mutasi-saku", label: "Aktivitas Saku Berbagi Saya", color: "orange", icon: "transaction" },
];

const generalMenus = [
  { href: "https://beramalbersama.com/tentang", label: "Tentang Kami",      color: "indigo", icon: "info" },
  { href: "/syarat-ketentuan",                  label: "Syarat & Ketentuan", color: "gray",   icon: "file" },
];

// Map icon name → SVG path
const iconPaths: Record<string, string> = {
  user:        "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
  archive:     "M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4",
  calendar:    "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  transaction: "M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4",
  info:        "M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  file:        "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
};
---

<MainLayout title="Akun Saya" description="Kelola profil dan aktivitas akun kamu.">
  <Header type="title" text="Akun" />

  <div class="max-w-[480px] mx-auto bg-gray-50 min-h-screen pb-24">
    <div class="px-4 pt-5 space-y-3">

      <!-- ── Error state ─────────────────────────────────────────────────── -->
      {fetchError && (
        <div class="bg-white rounded-2xl shadow-sm p-8 text-center">
          <p class="text-sm font-semibold text-red-500">Terjadi Kesalahan</p>
          <p class="text-xs text-gray-400 mt-1">Gagal memuat data akun. Coba muat ulang halaman.</p>
        </div>
      )}

      <!-- ── Belum login ─────────────────────────────────────────────────── -->
      {!isAuthenticated && (
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden px-5 py-8">
          <div class="flex flex-col items-center text-center mb-6">
            <div class="w-16 h-16 bg-teal-50 rounded-full flex items-center justify-center mb-3">
              <svg class="w-8 h-8 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <h3 class="text-base font-semibold text-gray-800">Masuk untuk Akses Fitur</h3>
            <p class="text-xs text-gray-400 mt-1">Kelola donasi, event, dan saldo Saku Berbagi kamu</p>
          </div>
          
          <a  href="/auth/login"
            class="w-full bg-teal-500 hover:bg-teal-600 text-white text-sm font-semibold py-3.5 rounded-xl transition-all flex items-center justify-center"
          >
            Masuk Sekarang
          </a>
          <p class="text-xs text-gray-400 text-center mt-3">
            Belum punya akun?&nbsp;
            <a href="/auth/register" class="text-teal-500 font-semibold">Daftar disini</a>
          </p>
        </div>
      )}

      <!-- ── Sudah login ─────────────────────────────────────────────────── -->
      {isAuthenticated && !fetchError && (
        <>
          <!-- Profile Card + Wallet -->
          <div class="space-y-2">

            <!-- Profile Card -->
            
            <a  href="/profil"
              class="relative flex items-center gap-3 bg-white rounded-2xl p-4 shadow-sm border border-gray-100 hover:shadow-md transition-all group"
            >
              <!-- Avatar -->
              {user?.img ? (
                <img
                  src={user.img}
                  alt={user?.name ?? "Profil"}
                  class="w-14 h-14 rounded-full object-cover shrink-0"
                />
              ) : (
                <div class="w-14 h-14 rounded-full bg-teal-100 flex items-center justify-center text-base font-bold text-teal-700 shrink-0">
                  {getInitialName(user?.name ?? "Hamba Allah")}
                </div>
              )}

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate">
                  {user?.name ?? "Hamba Allah"}
                </p>
                {user?.phone && (
                  <p class="text-xs text-gray-500 truncate mt-0.5">{user.phone}</p>
                )}
                {user?.email && (
                  <p class="text-xs text-gray-400 truncate">{user.email}</p>
                )}
              </div>

              <!-- Edit icon -->
              <svg class="w-4 h-4 text-gray-300 group-hover:text-teal-500 transition-colors absolute top-4 right-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            </a>

            <!-- Wallet Card -->
            <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
              <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
                <span class="w-1 h-5 bg-orange-500 rounded-full"></span>
                <span class="text-sm font-semibold text-gray-700">Saku Berbagi</span>
              </div>
              <div class="px-4 py-4 flex items-center justify-between">
                <div>
                  <p class="text-xs text-gray-400">Saldo tersedia</p>
                  <p class="text-lg font-bold text-gray-800 mt-0.5">
                    {wallet !== null ? formatRupiah(wallet) : "Rp 0"}
                  </p>
                </div>
                
                <a  href="/mutasi-saku"
                  class="flex items-center gap-1.5 text-xs font-semibold text-teal-600 bg-teal-50 hover:bg-teal-100 px-3 py-2 rounded-xl transition-colors"
                >
                  Riwayat
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Personal Menu -->
          <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
            <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
              <span class="w-1 h-5 bg-teal-500 rounded-full"></span>
              <span class="text-sm font-semibold text-gray-700">Menu Pribadi</span>
            </div>
            <div class="divide-y divide-gray-50">
              {personalMenus.map((menu) => (
                
                 <a href={menu.href}
                  class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 transition-colors group"
                >
                  <div class={`w-9 h-9 rounded-xl flex items-center justify-center bg-${menu.color}-50 shrink-0`}>
                    <svg class={`w-4 h-4 text-${menu.color}-600`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                    </svg>
                  </div>
                  <span class="flex-1 text-sm font-medium text-gray-700">{menu.label}</span>
                  <svg class="w-4 h-4 text-gray-300 group-hover:text-teal-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </>
      )}

      <!-- General Menu (selalu tampil) -->
      {!fetchError && (
        <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
            <span class="w-1 h-5 bg-gray-400 rounded-full"></span>
            <span class="text-sm font-semibold text-gray-700">Umum</span>
          </div>
          <div class="divide-y divide-gray-50">
            {generalMenus.map((menu) => (
              
               <a href={menu.href}
                target={menu.href.startsWith("http") ? "_blank" : undefined}
                rel={menu.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="flex items-center gap-3 px-4 py-3.5 hover:bg-gray-50 transition-colors group"
              >
                <div class={`w-9 h-9 rounded-xl flex items-center justify-center bg-${menu.color}-50 shrink-0`}>
                  <svg class={`w-4 h-4 text-${menu.color}-600`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[menu.icon]}/>
                  </svg>
                </div>
                <span class="flex-1 text-sm font-medium text-gray-700">{menu.label}</span>
                <svg class="w-4 h-4 text-gray-300 group-hover:text-teal-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Tombol Logout (hanya jika login) -->
      {isAuthenticated && !fetchError && (
        <button
          id="btn-logout"
          type="button"
          class="w-full flex items-center gap-3 px-4 py-3.5 bg-white rounded-2xl shadow-sm border border-red-100 hover:bg-red-50 transition-colors group"
        >
          <div class="w-9 h-9 bg-red-50 rounded-xl flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
          </div>
          <span class="flex-1 text-left text-sm font-medium text-red-500">Keluar</span>
          <svg class="w-4 h-4 text-red-300 group-hover:text-red-500 group-hover:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      )}

    </div>
  </div>

  <!-- Logout Confirmation Modal -->
  <div
    id="logout-modal"
    class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4"
  >
    <!-- Backdrop -->
    <div id="logout-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

    <!-- Modal -->
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-[400px] overflow-hidden">
      <!-- Icon -->
      <div class="flex flex-col items-center px-6 pt-7 pb-2 text-center">
        <div class="w-14 h-14 bg-red-50 rounded-full flex items-center justify-center mb-4">
          <svg class="w-7 h-7 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-800">Keluar Akun</h3>
        <p class="text-sm text-gray-400 mt-1.5">Apakah kamu yakin ingin keluar dari akun ini?</p>
      </div>

      <!-- Actions -->
      <div class="flex gap-2 px-6 py-5">
        <button
          id="btn-logout-cancel"
          type="button"
          class="flex-1 border border-gray-200 text-gray-600 text-sm font-semibold py-3 rounded-xl hover:bg-gray-50 transition-colors"
        >
          Batal
        </button>
        <button
          id="btn-logout-confirm"
          type="button"
          class="flex-1 bg-red-500 hover:bg-red-600 text-white text-sm font-semibold py-3 rounded-xl transition-all active:scale-95"
        >
          Ya, Keluar
        </button>
      </div>
    </div>
  </div>

  <BottomNav active="akun" />
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const btnLogout        = document.getElementById("btn-logout")         as HTMLButtonElement | null;
    const modal            = document.getElementById("logout-modal")       as HTMLElement;
    const backdrop         = document.getElementById("logout-backdrop")    as HTMLElement;
    const btnCancel        = document.getElementById("btn-logout-cancel")  as HTMLButtonElement;
    const btnConfirm       = document.getElementById("btn-logout-confirm") as HTMLButtonElement;

    // Jika belum login, tidak ada tombol logout
    if (!btnLogout) return;

    // ── Buka modal ───────────────────────────────────────────────────────────
    btnLogout.addEventListener("click", () => {
      modal.classList.remove("hidden");
    });

    // ── Tutup modal ──────────────────────────────────────────────────────────
    function closeModal() {
      modal.classList.add("hidden");
    }

    btnCancel.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);

    // ── Konfirmasi logout ────────────────────────────────────────────────────
    btnConfirm.addEventListener("click", async () => {
      btnConfirm.disabled = true;
      btnConfirm.textContent = "Keluar...";

      try {
        // Opsional: hit endpoint logout di server proxy
        await fetch("/api/logout", {
          method: "POST",
          credentials: "include",
          headers: {
            Accept: "application/json",
          },
        }).catch(() => {/* abaikan jika gagal, tetap hapus cookie */});

        // Hapus auth cookie
        document.cookie = "authToken=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; SameSite=Lax";

        showToast("Berhasil keluar", "success");
        window.location.href = "/";
      } catch {
        showToast("Gagal keluar, coba lagi", "error");
        btnConfirm.disabled = false;
        btnConfirm.textContent = "Ya, Keluar";
      }
    });
  });
</script>