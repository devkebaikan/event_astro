---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getInvoice } from "@/lib/FetchData";

import { formatRupiah } from "@/lib/formatter";

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/");

const invoiceRes = await getInvoice(slug);
const invoice = invoiceRes?.data;

if (!invoice) return Astro.redirect("/");

const payment = invoice.payment_method ?? {};
const donationAmount = invoice.nominal ?? 0;
const hasAccountNumber = payment.account_number && payment.account_number !== 0;
---

<MainLayout
  title="Panduan Pembayaran & Pelacakan Donasi"
  description="Temukan panduan lengkap tentang cara melakukan pembayaran dan melacak status donasi Anda di Aksiberbagi."
>
  <Header type="notshare" text="Panduan Pembayaran" link="/" />

  <section class="min-h-screen bg-gray-50">
    <div class="max-w-[480px] mx-auto px-4 py-4 pb-10 space-y-3">
      {/* ── Info Pembayaran ── */}
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        {/* Header bank */}
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-gray-100"
        >
          <p class="text-xs text-gray-500">Transfer Bank</p>
          {
            payment.image_url && (
              <img
                src={payment.image_url}
                alt={payment.name ?? "Bank"}
                class="h-7 object-contain"
              />
            )
          }
        </div>

        {/* Nomor rekening */}
        {
          hasAccountNumber && (
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
              <div>
                <p class="text-xs text-gray-500 mb-0.5">Nama Rekening</p>
                <p class="text-sm font-semibold text-gray-800">
                  {payment.account_behalf}
                </p>
                <p class="text-base font-mono font-bold text-gray-800 mt-0.5">
                  {payment.account_number}
                </p>
              </div>
              <button
                class="copy-btn p-2.5 border border-gray-300 rounded-xl text-primary-600 hover:bg-primary-50 hover:border-primary-400 transition-colors"
                data-copy={String(payment.account_number)}
                aria-label="Salin nomor rekening"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z" />
                  <path d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z" />
                </svg>
              </button>
            </div>
          )
        }

        {/* Jumlah donasi */}
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-gray-100"
        >
          <div>
            <p class="text-xs text-gray-500 mb-0.5">Jumlah Donasi</p>
            <p class="text-xl font-bold text-primary-600">
              {formatRupiah(donationAmount)}
            </p>
          </div>
          <button
            class="copy-btn p-2.5 border border-gray-300 rounded-xl text-primary-600 hover:bg-primary-50 hover:border-primary-400 transition-colors"
            data-copy={String(donationAmount)}
            aria-label="Salin jumlah donasi"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M8 3a1 1 0 011-1h2a1 1 0 110 2H9a1 1 0 01-1-1z"></path>
              <path
                d="M6 3a2 2 0 00-2 2v11a2 2 0 002 2h8a2 2 0 002-2V5a2 2 0 00-2-2 3 3 0 01-3 3H9a3 3 0 01-3-3z"
              ></path>
            </svg>
          </button>
        </div>

        {/* Peringatan penting */}
        <div class="px-4 py-3 border-b border-gray-100">
          <div
            class="flex gap-3 bg-amber-50 border-l-4 border-amber-400 rounded-r-xl p-3"
          >
            <svg
              class="w-4 h-4 text-amber-500 shrink-0 mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
                clip-rule="evenodd"></path>
            </svg>
            <p class="text-xs text-amber-900 leading-relaxed">
              <strong>PENTING!</strong> Mohon transfer tepat sampai 3 angka terakhir
              agar donasi terverifikasi otomatis.
            </p>
          </div>
          <p class="text-[11px] text-gray-400 text-center mt-2 italic">
            *Jumlah akan didonasikan hingga 3 digit terakhir
          </p>
        </div>
      </div>

      {/* ── Panduan Pembayaran ── */}
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-gray-100">
          <div class="w-1 h-5 bg-primary-500 rounded-full"></div>
          <h2 class="text-sm font-semibold text-gray-800">
            Panduan Pembayaran
          </h2>
        </div>
        <ol class="px-4 py-4 space-y-3 list-none">
          {
            [
              "Lakukan pembayaran melalui ATM / mobile banking / internet banking / SMS banking / kantor bank terdekat.",
              "Isi <strong>nomor rekening</strong> tujuan sesuai yang ada di halaman pembayaran <strong>(a.n Yayasan Aksi Berbagi)</strong>.",
              "Masukan <strong>nominal donasi</strong> sesuai jumlah donasimu, termasuk <strong>3 digit terakhir</strong>.",
              "Pembayaran akan diverifikasi oleh Aksiberbagi.com. Waktu verifikasi paling lambat 1×24 jam untuk sesama bank, dan 2×24 jam di hari kerja jika antar bank yang berbeda.",
            ].map((step, i) => (
              <li class="flex gap-3">
                <span class="w-6 h-6 rounded-full bg-primary-500 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <p
                  class="text-xs text-gray-600 leading-relaxed"
                  set:html={step}
                />
              </li>
            ))
          }
        </ol>
      </div>

      {/* ── Info Cards ── */}
      <div class="space-y-3">
        <div class="bg-white rounded-2xl shadow-sm px-4 py-4">
          <div class="flex items-start gap-3">
            <img
              src="/images/icons/credit-card.svg"
              alt=""
              class="w-8 h-8 shrink-0"
            />
            <div class="space-y-2.5">
              <p class="text-sm font-semibold text-gray-800">
                Bayar pakai Virtual Account untuk transaksi selanjutnya ya!
                Kenapa?
              </p>
              {
                [
                  [
                    "Bebas biaya transfer",
                    "Tidak ada tambahan kode unik ke jumlah donasi",
                  ],
                  [
                    "Verifikasi lebih cepat",
                    "Pembayaran terverifikasi otomatis",
                  ],
                  [
                    "Pembayaran lebih mudah",
                    "Tidak perlu upload bukti transfer",
                  ],
                ].map(([title, desc]) => (
                  <div>
                    <p class="text-xs font-semibold text-primary-600">{title}</p>
                    <p class="text-xs text-gray-500">{desc}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm px-4 py-4">
          <div class="flex items-start gap-3">
            <img
              src="/images/icons/balance-wallet.svg"
              alt=""
              class="w-8 h-8 shrink-0"
            />
            <div>
              <p class="text-sm font-semibold text-gray-800">
                Pembayaran terjamin
              </p>
              <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                Aksi Berbagi menjamin keamanan dana yang kamu bayarkan di tiap
                transaksi.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm px-4 py-4">
          <div class="flex items-start gap-3">
            <img
              src="/images/icons/fact-check.svg"
              alt=""
              class="w-8 h-8 shrink-0"
            />
            <div>
              <p class="text-sm font-semibold text-gray-800">
                Jaga keamanan datamu
              </p>
              <p class="text-xs text-gray-500 mt-1 leading-relaxed">
                Jangan menyebarkan bukti &amp; data pembayaran ke pihak manapun
                kecuali Aksiberbagi.com.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  import { showToast } from "@/lib/toast";

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const text = btn.dataset.copy ?? "";
        navigator.clipboard
          .writeText(text)
          .then(() => showToast("Disalin ke Clipboard"))
          .catch(() => showToast("Gagal menyalin", "error"));
      });
    });
  });
</script>
