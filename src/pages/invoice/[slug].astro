---
export const prerender = false;

import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getInvoice } from "@/lib/FetchData";
import InvoicePaidState from "@/components/invoice/InvoicePaidState.astro";
import InvoiceCanceledState from "@/components/invoice/InvoiceCanceledState.astro";
import InvoiceFreeState from "@/components/invoice/InvoiceFreeState.astro";
import InvoicePendingState from "@/components/invoice/InvoicePendingState.astro";
import { formatDateTime, formatRupiah } from "@/lib/formatter";

interface Props {
  invoice: any;
  slug: string;
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/");
}

const invoice = await getInvoice(slug);

const payment = invoice?.data?.payment_method ?? {};
const thirdPartyDetail = invoice?.data?.third_party_detail ?? {};
const donationAmount = invoice?.data?.nominal ?? 0;
const isPaid = invoice?.data?.status === "Paid";
const isCanceled =
  invoice?.data?.status === "Canceled" || invoice?.data?.status === "Expired";
const isFreeEvent = donationAmount === 0;
const payment_url = invoice?.data?.payment_url;
const firstItem = invoice?.data?.items?.[0] ?? invoice?.items?.[0] ?? {};
const eventInfo = firstItem?.event ?? invoice?.data?.event ?? {};
const eventName =
  firstItem?.name ?? eventInfo?.title ?? firstItem?.title ?? "Tiket Event";
const eventSlug = eventInfo?.slug ?? "";
const eventImage =
  eventInfo?.image_url ?? eventInfo?.image ?? firstItem?.image_url ?? "";
const eventWaGrup = eventInfo?.wa_grup ?? invoice?.data?.wa_grup ?? null;
const lastPaymentTime =
  invoice?.data?.last_payment_time ??
  invoice?.data?.payment_deadline_at ??
  null;
const rawPaymentDate =
  invoice?.data?.payment_date ?? invoice?.data?.updated_at ?? null;
const paymentDate = rawPaymentDate ? formatDateTime(rawPaymentDate) : null;

const formatted = isFreeEvent ? "Gratis (Rp 0)" : formatRupiah(donationAmount);
const lastThree = donationAmount > 0 ? formatted.slice(-3) : "";
const firstPart = donationAmount > 0 ? formatted.slice(0, -3) : "Rp 0";

// Deteksi jenis pembayaran
const isQris = payment?.bank === "Qris" || payment?.name === "Qris";
const isOvo = payment?.bank === "OVO" || payment?.name === "OVO";
const isVA = !!(
  thirdPartyDetail?.account_number && thirdPartyDetail?.bank_code
);

// QRIS payload
const qrPayload = isQris ? (thirdPartyDetail?.qr_string ?? "") : null;

// VA account details
const vaAccountNumber = isVA
  ? (thirdPartyDetail?.account_number ??
    thirdPartyDetail?.raw?.bill_payment?.receiver_bank_account?.account_number)
  : null;
const vaAccountName = isVA
  ? (thirdPartyDetail?.account_holder ?? payment?.account_behalf)
  : null;

const displayAccountNumber = isVA ? vaAccountNumber : payment?.account_number;
const displayAccountName = isVA ? vaAccountName : payment?.account_behalf;

// Redirect gateway jika perlu
const willAutoRedirect =
  !isPaid &&
  !isCanceled &&
  !isFreeEvent &&
  !!payment_url &&
  !qrPayload &&
  !isOvo &&
  !isVA;

const pageTitle = isPaid
  ? "Pembayaran Berhasil - Invoice"
  : isCanceled
    ? "Transaksi Dibatalkan - Invoice"
    : isFreeEvent
      ? "Pendaftaran Event Berhasil - Invoice"
      : "Invoice Pembayaran Event";
---

<MainLayout
  title={pageTitle}
  description="Detail invoice pendaftaran dan pembayaran event Anda."
>
  <Header type="notshare" text="Invoice Event" link="/" />

  <!-- <ShowJsonData data={invoice} /> -->

  <!-- Main Content Wrapper -->
  <section
    id="invoice-page"
    data-slug={slug}
    data-amount={donationAmount}
    data-paid={isPaid}
    data-payment-url={payment_url}
    data-qr-code={qrPayload}
    data-payment-type={isQris ? "qris" : isOvo ? "ovo" : isVA ? "va" : "other"}
    class="min-h-screen"
  >
    {
      willAutoRedirect ? (
        <div class="min-h-screen flex flex-col items-center justify-center gap-4 p-6 text-center">
          <div class="animate-spin h-8 w-8 border-4 border-primary-500 border-t-transparent rounded-full" />
          <p class="text-sm text-neutral-600">
            Mengalihkan ke halaman pembayaran...
          </p>
          <a
            href={payment_url}
            id="btn-manual-redirect"
            class="text-sm font-medium text-primary-600 underline"
          >
            Klik di sini jika tidak otomatis teralihkan
          </a>
        </div>
      ) : isPaid ? (
        <InvoicePaidState
          slug={slug}
          donationAmount={donationAmount}
          eventName={eventName}
          eventImage={eventImage}
          eventSlug={eventSlug}
          paymentName={payment?.name || payment?.bank}
          paymentDate={paymentDate}
          eventWaGrup={eventWaGrup}
          formattedAmount={formatted}
        />
      ) : isCanceled ? (
        <InvoiceCanceledState
          slug={slug}
          eventName={eventName}
          eventImage={eventImage}
          eventSlug={eventSlug}
          paymentName={payment?.name || payment?.bank}
          formattedAmount={formatted}
        />
      ) : isFreeEvent ? (
        <InvoiceFreeState
          slug={slug}
          eventName={eventName}
          eventImage={eventImage}
          eventSlug={eventSlug}
          eventWaGrup={eventWaGrup}
        />
      ) : (
        <InvoicePendingState
          slug={slug}
          donationAmount={donationAmount}
          lastPaymentTime={lastPaymentTime}
          payment={payment}
          isQris={isQris}
          isOvo={isOvo}
          qrPayload={qrPayload}
          displayAccountNumber={displayAccountNumber}
          displayAccountName={displayAccountName}
          firstPart={firstPart}
          lastThree={lastThree}
        />
      )
    }
  </section>

  <script>
    import { showToast } from "@/lib/toast";
    import { sendInitialCheckoutEvent } from "@/lib/pixels";
    import { trackBeginCheckout, trackPurchase } from "@/lib/tracking";

    let hasTracked = false;

    // Countdown Timer
    let timerInterval: number | null = null;

    function initCountdown() {
      const countdownWrapper = document.getElementById(
        "payment-countdown-wrapper",
      );
      if (!countdownWrapper) return;

      const deadlineStr = countdownWrapper.dataset.deadline;
      if (!deadlineStr) return;

      const targetTime = new Date(deadlineStr).getTime();
      if (isNaN(targetTime)) return;

      const hoursEl = document.getElementById("cd-hours");
      const minutesEl = document.getElementById("cd-minutes");
      const secondsEl = document.getElementById("cd-seconds");
      const statusEl = document.getElementById("countdown-status");
      const boxesEl = document.getElementById("countdown-boxes");

      if (timerInterval) clearInterval(timerInterval);

      const updateCountdown = () => {
        const now = Date.now();
        const diff = targetTime - now;

        if (diff <= 0) {
          if (timerInterval) clearInterval(timerInterval);
          if (hoursEl) hoursEl.textContent = "00";
          if (minutesEl) minutesEl.textContent = "00";
          if (secondsEl) secondsEl.textContent = "00";
          if (statusEl) statusEl.classList.remove("hidden");
          if (boxesEl) boxesEl.classList.add("opacity-50");
          return;
        }

        const totalSeconds = Math.floor(diff / 1000);
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;

        if (hoursEl) hoursEl.textContent = String(hours).padStart(2, "0");
        if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, "0");
        if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, "0");
      };

      updateCountdown();
      timerInterval = window.setInterval(updateCountdown, 1000);
    }

    function initInvoicePage() {
      initCountdown();
      const el = document.getElementById("invoice-page");
      if (!el) return;

      const slug = el.dataset.slug;
      const donationAmount = Number(el.dataset.amount || 0);
      const paymentUrl = el.dataset.paymentUrl;
      const qrCode = el.dataset.qrCode;
      const paymentType = el.dataset.paymentType; // "qris" | "ovo" | "va" | "other"

      // Tracking cukup dikirim sekali
      if (!hasTracked) {
        hasTracked = true;
        sendInitialCheckoutEvent(slug, donationAmount);
        trackBeginCheckout({
          programId: slug || "",
          value: donationAmount,
        });
        trackPurchase({
          invoice: slug || "",
          programId: slug || "",
          programName: "Donasi",
          value: donationAmount,
        });
      }

      if (paymentUrl && !qrCode && paymentType === "other") {
        // Cuma redirect untuk metode yang bukan Qris/OVO/VA
        setTimeout(() => {
          window.location.href = paymentUrl;
        }, 3000);
      }
    }

    document.addEventListener("DOMContentLoaded", initInvoicePage);

    window.addEventListener("pageshow", (e) => {
      if (e.persisted) {
        initInvoicePage();
      }
    });

    // clipboard
    document.querySelectorAll(".copy-btn").forEach((button) => {
      button.addEventListener("click", () => {
        const textToCopy = button.getAttribute("data-copy");
        if (textToCopy) {
          navigator.clipboard
            .writeText(String(textToCopy))
            .then(() => showToast("Disalin ke Clipboard", "success"))
            .catch(() => showToast("Gagal menyalin", "error"));
        }
      });
    });
  </script>
</MainLayout>
