---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";
import { getMyTransactionEvents } from "@/lib/FetchData";
import { formatDate, formatDateTime, formatRupiah } from "@/lib/formatter";

const { isAuthenticated, token } = Astro.locals.auth;

let initialTransactions: any[] = [];
let hasNextPage = false;

if (isAuthenticated && token) {
  const res = await getMyTransactionEvents(token, {
    filter: "semua",
    mode: "pagination",
    limit: 10,
    page: 1,
  });

  const rawData = res?.data;
  if (Array.isArray(rawData?.data)) {
    initialTransactions = rawData.data;
    hasNextPage = !!rawData.next_page_url || (rawData.current_page < rawData.last_page);
  } else if (Array.isArray(rawData)) {
    initialTransactions = rawData;
    hasNextPage = false;
  }
}

const currentPath = Astro.url.pathname + Astro.url.search;
---

<MainLayout
  title="Event Saya"
  description="Daftar tiket dan event yang telah kamu daftarkan atau ikuti."
>
  <Header type="notshare" text="Event Saya" />

  <div
    id="my-events-page"
    data-authenticated={isAuthenticated ? "true" : "false"}
    class="max-w-[480px] mx-auto bg-neutral-50 min-h-screen pt-4 pb-28 px-4"
  >
    <!-- GUEST / BELUM LOGIN STATE  -->
    {!isAuthenticated && (
      <div class="pt-4 space-y-4">
         <div class="bg-white rounded-2xl border border-gray-100 p-8 flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full border border-primary-200 flex items-center justify-center mb-5">
            <svg class="w-7 h-7 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <h3 class="text-base font-semibold text-gray-900 mb-1.5 tracking-tight">Masuk ke Akunmu</h3>
          <p class="text-xs text-gray-400 leading-relaxed mb-7 max-w-[350px]">
            Masuk untuk melihat tiket, jadwal acara, riwayat transaksi, dan detail event yang telah kamu ikuti.
          </p>
          <a
            href={`/auth/login?from=${encodeURIComponent(currentPath)}`}
            class="w-full bg-primary-500 hover:bg-primary-600 active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed text-white text-sm font-semibold py-4 rounded-full transition-all duration-150 mt-2"
          >
            Masuk Sekarang
          </a>
          <p class="text-xs text-gray-400 mt-4">
            Belum punya akun?&nbsp;
            <a href="/auth/register" class="text-primary-600 font-semibold">Daftar disini</a>
          </p>
        </div>

        <!-- Callout Banner info -->
        <div class="bg-primary-50/60 rounded-2xl border border-primary-100/80 p-4 flex items-start gap-3">
          <svg class="w-5 h-5 text-primary-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="text-xs text-gray-600 leading-relaxed">
            <span class="font-semibold text-gray-800">Kenapa perlu login?</span>
            <p class="text-gray-500 mt-0.5">Semua tiket dan akses webinar/acara tersimpan rapi dan aman di dalam akunmu.</p>
          </div>
        </div>
      </div>
    )}

    <!-- AUTHENTICATED / SUDAH LOGIN  -->
    {isAuthenticated && (
      <div>
        <!-- Filter Tabs (Semua / Mendatang / Selesai) -->
        <div class="sticky top-[73px] z-10 bg-neutral-50 pb-3 pt-1">
          <div class="flex items-center gap-1.5 bg-gray-100 p-1.5 rounded-2xl border border-gray-100 shadow-sm">
            <button
              type="button"
              data-filter="semua"
              class="filter-tab flex-1 py-2 text-xs font-semibold text-center rounded-xl bg-primary-500 text-white shadow-sm transition-all"
            >
              Semua
            </button>
            <button
              type="button"
              data-filter="mendatang"
              class="filter-tab flex-1 py-2 text-xs font-semibold text-center rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-50 transition-all"
            >
              Mendatang
            </button>
            <button
              type="button"
              data-filter="selesai"
              class="filter-tab flex-1 py-2 text-xs font-semibold text-center rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-50 transition-all"
            >
              Selesai
            </button>
          </div>

          <!-- Status Sub-filters (Horizontal Chips) -->
          <div class="flex items-center gap-2 mt-2.5 overflow-x-auto pb-1 no-scrollbar">
            <button
              type="button"
              data-status=""
              class="status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-primary-50 text-primary-700 border-primary-200"
            >
              Semua Status
            </button>
            <button
              type="button"
              data-status="Paid"
              class="status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50"
            >
              Sudah Bayar
            </button>
            <button
              type="button"
              data-status="Pending"
              class="status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50"
            >
              Menunggu Bayar
            </button>
            <button
              type="button"
              data-status="Canceled"
              class="status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50"
            >
              Dibatalkan
            </button>
          </div>
        </div>

        <!-- Skeleton Loader (Hidden by default) -->
        <div id="events-skeleton" class="hidden space-y-3 mt-3">
          {[1, 2, 3].map(() => (
            <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm animate-pulse space-y-3">
              <div class="flex items-center justify-between">
                <div class="h-3.5 bg-gray-200 rounded w-28"></div>
                <div class="h-4 bg-gray-200 rounded-full w-20"></div>
              </div>
              <div class="flex gap-3">
                <div class="w-20 h-20 bg-gray-200 rounded-xl shrink-0"></div>
                <div class="flex-1 space-y-2 py-0.5">
                  <div class="h-3 bg-gray-200 rounded w-1/3"></div>
                  <div class="h-4 bg-gray-200 rounded w-5/6"></div>
                  <div class="h-3 bg-gray-200 rounded w-1/2"></div>
                </div>
              </div>
              <div class="pt-2 border-t border-gray-50 flex items-center justify-between">
                <div class="h-3.5 bg-gray-200 rounded w-24"></div>
                <div class="h-7 bg-gray-200 rounded-xl w-24"></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Empty State -->
        <div
          id="events-empty"
          class={`bg-white rounded-3xl p-8 text-center border border-gray-100 shadow-sm mt-3 ${initialTransactions.length === 0 ? "" : "hidden"}`}
        >
          <div class="w-16 h-16 bg-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-primary-500">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
              <path d="M7.5 9l1 1 2-2" />
              <path d="M13.5 9h3" />
              <path d="M7.5 15l1 1 2-2" />
              <path d="M13.5 15h3" />
            </svg>
          </div>
          <h3 id="empty-title" class="text-base font-bold text-gray-900 mb-1">Belum Ada Event</h3>
          <p id="empty-desc" class="text-xs text-gray-400 mb-6 leading-relaxed max-w-xs mx-auto">
            Kamu belum memiliki event pada kategori ini. Temukan berbagai event menarik dan daftarkan dirimu sekarang!
          </p>
          <a
            href="/"
            class="inline-flex items-center justify-center bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-6 py-3 rounded-xl transition-all shadow-sm hover:shadow active:scale-95"
          >
            Eksplor Event Sekarang
          </a>
        </div>

        <!-- Events List Container -->
        <div id="events-list" class="space-y-3 mt-3">
          {initialTransactions.map((item) => {
            const ev = item.event || {};
            const payment = item.payment || {};
            const status = payment.status || item.status || "Pending";
            const isPaid = status === "Paid" || payment.is_paid;
            const isCanceled = status === "Canceled";
            const invoiceNo = item.invoice || "-";
            const eventSlug = ev.slug || "";
            const totalNominal = item.total_payment ?? item.nominal ?? ev.price ?? 0;
            const formattedTotal = totalNominal === 0 ? "Gratis" : formatRupiah(totalNominal);
            const eventDate = ev.datetime ? formatDateTime(ev.datetime) : (item.date ? formatDate(item.date) : "-");

            return (
              <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm hover:border-primary-200 transition-all space-y-3">
                <!-- Top Header: Invoice & Status Badge -->
                <div class="flex items-center justify-between text-xs pb-2 border-b border-gray-50">
                  <div class="flex items-center gap-1.5 text-gray-400 font-mono text-[11px]">
                    <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="truncate font-semibold text-gray-600">{invoiceNo}</span>
                  </div>

                  {isPaid ? (
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2.5 py-0.5 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      {payment.status_label || "Sudah Bayar"}
                    </span>
                  ) : isCanceled ? (
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-50 border border-rose-200/80 px-2.5 py-0.5 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                      {payment.status_label || "Dibatalkan"}
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-full">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                      {payment.status_label || "Menunggu Pembayaran"}
                    </span>
                  )}
                </div>

                <!-- Event Info (Horizontal layout) -->
                <div class="flex gap-3">
                  <a href={eventSlug ? `/event/${eventSlug}` : "#"} class="shrink-0 group">
                    <img
                      src={ev.image_url || "/assets/banner/banner-event.webp"}
                      alt={ev.title || "Event"}
                      class="w-20 h-20 rounded-xl object-cover bg-gray-100 group-hover:scale-105 transition-transform"
                      loading="lazy"
                    />
                  </a>

                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 mb-1">
                      <span class="inline-block text-[10px] font-bold text-primary-600 bg-primary-50 px-2 py-0.5 rounded-full">
                        {ev.type?.name || "Event"} {ev.mode ? `· ${ev.mode}` : ""}
                      </span>
                    </div>

                    <a
                      href={eventSlug ? `/event/${eventSlug}` : "#"}
                      class="block text-xs font-bold text-gray-900 line-clamp-2 hover:text-primary-600 transition-colors leading-snug"
                    >
                      {ev.title || "Nama Event"}
                    </a>

                    <!-- Schedule -->
                    <div class="flex items-center gap-1.5 text-[11px] text-gray-500 mt-1.5">
                      <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span class="truncate">{eventDate}</span>
                    </div>

                    <!-- Location / Mode -->
                    {ev.location && (
                      <div class="flex items-center gap-1.5 text-[11px] text-gray-500 mt-0.5">
                        <svg class="w-3.5 h-3.5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        <span class="truncate">{ev.location}</span>
                      </div>
                    )}
                  </div>
                </div>

                <!-- Footer / Action Area -->
                <div class="pt-2.5 border-t border-gray-50 flex items-center justify-between gap-2">
                  <div>
                    <span class="text-[10px] text-gray-400 block font-medium">Total Pembayaran</span>
                    <span class="text-xs font-bold text-gray-900">{formattedTotal}</span>
                  </div>

                  <div class="flex items-center gap-2">
                    {invoiceNo && invoiceNo !== "-" && (
                      <a
                        href={`/invoice/${invoiceNo}`}
                        class={`text-xs font-semibold px-3.5 py-1.5 rounded-xl transition-all active:scale-95 ${
                          !isPaid && !isCanceled
                            ? "bg-primary-500 hover:bg-primary-600 text-white shadow-sm"
                            : "bg-gray-100 hover:bg-gray-200 text-gray-700"
                        }`}
                      >
                        {!isPaid && !isCanceled ? "Bayar Sekarang" : "Invoice"}
                      </a>
                    )}

                    {eventSlug && (
                      <a
                        href={`/event/${eventSlug}`}
                        class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-primary-50 hover:bg-primary-100 text-primary-700 transition-all active:scale-95"
                      >
                        Detail
                      </a>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Load More Button -->
        <div id="load-more-wrap" class={`flex justify-center mt-6 ${hasNextPage ? "" : "hidden"}`}>
          <button
            id="btn-load-more"
            type="button"
            class="flex items-center gap-2 bg-white border border-gray-200 hover:border-primary-400 hover:bg-primary-50 text-gray-600 hover:text-primary-600 font-semibold text-xs px-6 py-2.5 rounded-2xl shadow-sm transition-all duration-200"
          >
            Tampilkan Lebih Banyak
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </div>
    )}
  </div>

  <BottomNav active="event-saya" />
</MainLayout>

<script>
  import { getToken, isLoggedIn, bearerHeaders } from "@/lib/auth";
  import { formatDate, formatDateTime, formatRupiah } from "@/lib/formatter";

  (() => {
    const pageEl = document.getElementById("my-events-page");
    if (!pageEl || pageEl.dataset.authenticated !== "true") return;

    const token = getToken();
    if (!isLoggedIn() || !token) return;

    const filterTabs   = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
    const statusChips  = document.querySelectorAll<HTMLButtonElement>(".status-chip");
    const eventsList   = document.getElementById("events-list") as HTMLElement;
    const skeleton     = document.getElementById("events-skeleton") as HTMLElement;
    const emptyState   = document.getElementById("events-empty") as HTMLElement;
    const emptyTitle   = document.getElementById("empty-title") as HTMLElement;
    const emptyDesc    = document.getElementById("empty-desc") as HTMLElement;
    const loadMoreWrap = document.getElementById("load-more-wrap") as HTMLElement;
    const btnLoadMore  = document.getElementById("btn-load-more") as HTMLButtonElement;

    let activeFilter = "semua";
    let activeStatus = "";
    let currentPage  = 1;
    let isFetching   = false;
    let hasNextPage  = !loadMoreWrap.classList.contains("hidden");

    function renderCardHTML(item: any): string {
      const ev = item.event || {};
      const payment = item.payment || {};
      const status = payment.status || item.status || "Pending";
      const isPaid = status === "Paid" || payment.is_paid;
      const isCanceled = status === "Canceled";
      const invoiceNo = item.invoice || "-";
      const eventSlug = ev.slug || "";
      const totalNominal = item.total_payment ?? item.nominal ?? ev.price ?? 0;
      const formattedTotal = totalNominal === 0 ? "Gratis" : formatRupiah(totalNominal);
      const eventDate = ev.datetime ? formatDateTime(ev.datetime) : (item.date ? formatDate(item.date) : "-");

      const statusBadge = isPaid
        ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200/80 px-2.5 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            ${payment.status_label || "Sudah Bayar"}
          </span>`
        : isCanceled
        ? `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-50 border border-rose-200/80 px-2.5 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
            ${payment.status_label || "Dibatalkan"}
          </span>`
        : `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-700 bg-amber-50 border border-amber-200/80 px-2.5 py-0.5 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
            ${payment.status_label || "Menunggu Pembayaran"}
          </span>`;

      const locationRow = ev.location
        ? `<div class="flex items-center gap-1.5 text-[11px] text-gray-500 mt-0.5">
            <svg class="w-3.5 h-3.5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="truncate">${ev.location}</span>
          </div>`
        : "";

      const actionButton = invoiceNo && invoiceNo !== "-"
        ? `<a href="/invoice/${invoiceNo}" class="text-xs font-semibold px-3.5 py-1.5 rounded-xl transition-all active:scale-95 ${
            !isPaid && !isCanceled
              ? "bg-primary-500 hover:bg-primary-600 text-white shadow-sm"
              : "bg-gray-100 hover:bg-gray-200 text-gray-700"
          }">
            ${!isPaid && !isCanceled ? "Bayar Sekarang" : "Invoice"}
          </a>`
        : "";

      const detailButton = eventSlug
        ? `<a href="/event/${eventSlug}" class="text-xs font-semibold px-3 py-1.5 rounded-xl bg-primary-50 hover:bg-primary-100 text-primary-700 transition-all active:scale-95">
            Detail
          </a>`
        : "";

      return `
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm hover:border-primary-200 transition-all space-y-3">
          <div class="flex items-center justify-between text-xs pb-2 border-b border-gray-50">
            <div class="flex items-center gap-1.5 text-gray-400 font-mono text-[11px]">
              <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="truncate font-semibold text-gray-600">${invoiceNo}</span>
            </div>
            ${statusBadge}
          </div>

          <div class="flex gap-3">
            <a href="${eventSlug ? `/event/${eventSlug}` : "#"}" class="shrink-0 group">
              <img
                src="${ev.image_url || "/assets/banner/banner-event.webp"}"
                alt="${ev.title || "Event"}"
                class="w-20 h-20 rounded-xl object-cover bg-gray-100 group-hover:scale-105 transition-transform"
                loading="lazy"
              />
            </a>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 mb-1">
                <span class="inline-block text-[10px] font-bold text-primary-600 bg-primary-50 px-2 py-0.5 rounded-full">
                  ${ev.type?.name || "Event"} ${ev.mode ? `· ${ev.mode}` : ""}
                </span>
              </div>

              <a
                href="${eventSlug ? `/event/${eventSlug}` : "#"}"
                class="block text-xs font-bold text-gray-900 line-clamp-2 hover:text-primary-600 transition-colors leading-snug"
              >
                ${ev.title || "Nama Event"}
              </a>

              <div class="flex items-center gap-1.5 text-[11px] text-gray-500 mt-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span class="truncate">${eventDate}</span>
              </div>

              ${locationRow}
            </div>
          </div>

          <div class="pt-2.5 border-t border-gray-50 flex items-center justify-between gap-2">
            <div>
              <span class="text-[10px] text-gray-400 block font-medium">Total Pembayaran</span>
              <span class="text-xs font-bold text-gray-900">${formattedTotal}</span>
            </div>

            <div class="flex items-center gap-2">
              ${actionButton}
              ${detailButton}
            </div>
          </div>
        </div>
      `;
    }

    async function fetchMyEvents(page: number, append = false) {
      if (isFetching) return;
      isFetching = true;

      if (!append) {
        eventsList.innerHTML = "";
        skeleton.classList.remove("hidden");
        emptyState.classList.add("hidden");
        loadMoreWrap.classList.add("hidden");
      } else {
        btnLoadMore.disabled = true;
        btnLoadMore.innerHTML = `<span class="w-4 h-4 border-2 border-gray-300 border-t-primary-500 rounded-full animate-spin"></span> Memuat...`;
      }

      try {
        const url = new URL("/api/dashboard/donatur/my-transaction-event", window.location.origin);
        url.searchParams.set("filter", activeFilter);
        if (activeStatus) url.searchParams.set("status", activeStatus);
        url.searchParams.set("mode", "pagination");
        url.searchParams.set("limit", "10");
        url.searchParams.set("page", String(page));

        const res = await fetch(url.toString(), {
          headers: bearerHeaders(token),
        });

        if (res.status === 401) {
          window.location.href = `/auth/login?from=${encodeURIComponent(window.location.pathname + window.location.search)}`;
          return;
        }

        const json = res.ok ? await res.json() : null;
        const rawData = json?.data;
        let items: any[] = [];

        if (Array.isArray(rawData?.data)) {
          items = rawData.data;
          hasNextPage = !!rawData.next_page_url || (rawData.current_page < rawData.last_page);
        } else if (Array.isArray(rawData)) {
          items = rawData;
          hasNextPage = false;
        }

        skeleton.classList.add("hidden");

        if (items.length === 0 && !append) {
          emptyState.classList.remove("hidden");
          const filterText = activeFilter === "mendatang" ? "mendatang" : (activeFilter === "selesai" ? "selesai" : "");
          emptyTitle.textContent = "Belum Ada Event";
          emptyDesc.textContent = filterText
            ? `Kamu belum memiliki event ${filterText}. Temukan event menarik dan ikuti acaranya!`
            : "Kamu belum memiliki event. Temukan event menarik dan ikuti acaranya!";
        } else {
          emptyState.classList.add("hidden");
          const html = items.map(renderCardHTML).join("");
          if (append) {
            eventsList.insertAdjacentHTML("beforeend", html);
          } else {
            eventsList.innerHTML = html;
          }
        }

        loadMoreWrap.classList.toggle("hidden", !hasNextPage);
      } catch (err) {
        skeleton.classList.add("hidden");
        if (!append && eventsList.children.length === 0) {
          emptyState.classList.remove("hidden");
          emptyTitle.textContent = "Gagal Memuat Event";
          emptyDesc.textContent = "Terjadi kendala saat memuat data event kamu. Silakan coba beberapa saat lagi.";
        }
      } finally {
        isFetching = false;
        btnLoadMore.disabled = false;
        btnLoadMore.innerHTML = `Tampilkan Lebih Banyak <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>`;
      }
    }

    // Filter Tabs Click
    filterTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const filterVal = tab.dataset.filter || "semua";
        if (activeFilter === filterVal) return;

        activeFilter = filterVal;
        currentPage = 1;

        filterTabs.forEach((t) => {
          t.className = "filter-tab flex-1 py-2 text-xs font-semibold text-center rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-50 transition-all";
        });
        tab.className = "filter-tab flex-1 py-2 text-xs font-semibold text-center rounded-xl bg-primary-500 text-white shadow-sm transition-all";

        fetchMyEvents(1, false);
      });
    });

    // Status Chips Click
    statusChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const statusVal = chip.dataset.status || "";
        if (activeStatus === statusVal) return;

        activeStatus = statusVal;
        currentPage = 1;

        statusChips.forEach((c) => {
          c.className = "status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-white text-gray-600 border-gray-200 hover:bg-gray-50";
        });
        chip.className = "status-chip whitespace-nowrap px-3 py-1.5 rounded-xl text-[11px] font-semibold border transition-all bg-primary-50 text-primary-700 border-primary-200";

        fetchMyEvents(1, false);
      });
    });

    // Load More Click
    btnLoadMore?.addEventListener("click", () => {
      currentPage++;
      fetchMyEvents(currentPage, true);
    });
  })();
</script>
