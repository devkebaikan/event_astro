---
export const prerender = false;

import BottomNav from "@/components/layouts/BottomNav.astro";
import Header from "@/components/layouts/Header.astro";
import MainLayout from "@/layouts/MainLayout.astro";

// Data dummy/state event saya
const myEvents: any[] = [];
---

<MainLayout
  title="Event Saya"
  description="Daftar event yang telah kamu daftarkan atau ikuti."
>
    <Header type="onlyicon" />


  <div class="max-w-[480px] mt-[65px] mx-auto bg-gray-50 min-h-screen pt-4 pb-28 px-4">
    <!-- Filter tabs -->
    <div class="flex items-center gap-2 mb-4 bg-white p-1.5 rounded-2xl border border-gray-100 shadow-sm">
      <button
        type="button"
        class="flex-1 py-2 text-xs font-semibold text-center rounded-xl bg-primary-500 text-white shadow-sm transition-all"
      >
        Semua
      </button>
      <button
        type="button"
        class="flex-1 py-2 text-xs font-semibold text-center rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-50 transition-all"
      >
        Mendatang
      </button>
      <button
        type="button"
        class="flex-1 py-2 text-xs font-semibold text-center rounded-xl text-gray-500 hover:text-gray-800 hover:bg-gray-50 transition-all"
      >
        Selesai
      </button>
    </div>

    {myEvents.length === 0 ? (
      <!-- Empty state -->
      <div class="bg-white rounded-3xl p-8 text-center border border-gray-100 shadow-sm mt-4">
        <div class="w-16 h-16 bg-primary-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-primary-500">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
            <path d="M7.5 9l1 1 2-2" />
            <path d="M13.5 9h3" />
            <path d="M7.5 15l1 1 2-2" />
            <path d="M13.5 15h3" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-gray-900 mb-1">Belum Ada Event</h3>
        <p class="text-xs text-gray-400 mb-6 leading-relaxed max-w-xs mx-auto">
          Kamu belum mendaftar di event manapun. Temukan berbagai event menarik dan daftarkan dirimu sekarang!
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold px-6 py-3 rounded-xl transition-all shadow-sm hover:shadow active:scale-95"
        >
          Eksplor Event Sekarang
        </a>
      </div>
    ) : (
      <!-- Event list -->
      <div class="space-y-3">
        {myEvents.map((item) => (
          <div class="bg-white rounded-2xl p-3 border border-gray-100 shadow-sm flex gap-3">
            <img
              src={item.image}
              alt={item.title}
              class="w-20 h-20 rounded-xl object-cover"
            />
            <div class="flex-1 min-w-0">
              <span class="inline-block text-[10px] font-bold text-primary-600 bg-primary-50 px-2 py-0.5 rounded-full mb-1">
                {item.category}
              </span>
              <h4 class="text-xs font-bold text-gray-900 truncate">
                {item.title}
              </h4>
              <p class="text-[11px] text-gray-400 mt-1">{item.date}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <BottomNav active="event-saya" />
</MainLayout>
