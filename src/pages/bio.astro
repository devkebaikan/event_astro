---

<MainLayout title="Bio Beramalbersama.com" description="Platform donasi online terpercaya. Bergabung bersama 100rb+ donatur dan salurkan kebaikan Anda.">

  <div class="bg-neutral-100 min-h-screen">
    <div class="max-w-[480px] mx-auto">

      <!-- Banner -->
      <div class="w-full h-52 overflow-hidden relative">
        <img
          src="/images/banner/Tentang-Aksiberbagi.webp"
          alt="Beramalbersama Banner"
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-100 via-transparent to-transparent" />
      </div>

      <!-- Profile Card -->
      <div class="bg-white mx-4 -mt-10 relative z-10 rounded-2xl shadow-md px-5 pt-5 pb-6">
        <!-- Avatar -->
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 rounded-full border-2 border-primary-200 overflow-hidden shadow">
            <img src="/images/logo-akber-green.webp" alt="Logo" class="w-full h-full object-contain p-1" />
          </div>
          <div>
            <h1 class="text-base font-bold text-neutral-900 m-0 leading-tight">Beramalbersama.com</h1>
            <p class="text-xs text-primary-500 font-medium m-0">Platform Donasi Terpercaya</p>
            <p class="text-[11px] text-neutral-400 m-0">@aksiberbagi · Sejak 2020</p>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 divide-x divide-neutral-100 border border-neutral-100 rounded-xl mb-4">
          <div class="flex flex-col items-center py-3 px-2">
            <p class="text-xl font-black text-primary-600 tracking-tight m-0">900+</p>
            <p class="text-[10px] uppercase tracking-wider text-neutral-400 text-center m-0 mt-0.5">Program Tersalurkan</p>
          </div>
          <div class="flex flex-col items-center py-3 px-2">
            <p class="text-xl font-black text-primary-600 tracking-tight m-0">100rb+</p>
            <p class="text-[10px] uppercase tracking-wider text-neutral-400 text-center m-0 mt-0.5">Donatur Bergabung</p>
          </div>
        </div>

        <!-- Tagline -->
        <p class="text-sm text-neutral-500 text-center leading-relaxed m-0">
          Resmi dan terpercaya sejak 2020. Yuk bergabung dan ciptakan lebih banyak senyuman bersama
          <span class="font-bold text-primary-600">#SahabatBerbagi</span>
        </p>

        <!-- Legal Badges -->
        <div class="flex flex-wrap justify-center gap-2 mt-4">
          {["Terdaftar Kemenkumham", "Izin OJK", "Anggota BAZNAS"].map((badge) => (
            <span class="text-[10px] font-semibold bg-primary-50 text-primary-700 border border-primary-100 px-2.5 py-1 rounded-full">
              ✓ {badge}
            </span>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="px-4 mt-5 space-y-2.5">
        <p class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-semibold px-1">Menu Utama</p>
        {links.map((link) => (
          <a
            href={link.href}
            class="flex items-center gap-3 bg-white rounded-xl px-4 py-3.5 shadow-sm border border-neutral-100 hover:border-primary-300 hover:shadow-md transition-all duration-200 group"
          >
            <div class="w-9 h-9 bg-primary-50 rounded-lg flex items-center justify-center shrink-0 group-hover:bg-primary-100 transition-colors">
              <svg class="w-4.5 h-4.5 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={link.icon} />
              </svg>
            </div>
            <span class="text-sm font-semibold text-neutral-800 flex-1 group-hover:text-primary-600 transition-colors">{link.label}</span>
            <svg class="w-4 h-4 text-neutral-300 group-hover:text-primary-400 transition-colors" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
          </a>
        ))}
      </div>

      <!-- Separator -->
      <div class="flex items-center gap-3 mx-4 my-6">
        <span class="flex-1 h-px bg-neutral-200" />
        <span class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-semibold">Rekomendasi Program</span>
        <span class="flex-1 h-px bg-neutral-200" />
      </div>

      <!-- Programs -->
      <div class="px-4 space-y-3">
        {programs.map((p) => (
          <a
            href={p.link}
            class="flex gap-3 bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden hover:shadow-md transition-all duration-200 group"
          >
            <div class="relative w-24 h-24 shrink-0">
              <img src={p.image} alt={p.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="flex-1 py-3 pr-3 flex flex-col justify-between">
              <p class="text-xs font-semibold text-neutral-800 m-0 line-clamp-2 leading-snug group-hover:text-primary-600 transition-colors">
                {p.title}
              </p>
              <div>
                <div class="w-full bg-neutral-100 rounded-full h-1 mb-1.5">
                  <div class="bg-primary-500 h-1 rounded-full transition-all" style={`width: ${p.progress}%`} />
                </div>
                <div class="flex items-center justify-between">
                  <p class="text-[10px] text-neutral-400 m-0">Terkumpul</p>
                  <p class="text-[11px] font-bold text-primary-600 m-0">{p.collected}</p>
                </div>
              </div>
            </div>
          </a>
        ))}

        <a
          href="/"
          class="flex items-center justify-center gap-2 w-full py-3 border-2 border-dashed border-primary-200 text-primary-500 text-sm font-semibold rounded-2xl hover:bg-primary-50 transition-colors"
        >
          Lihat Semua Program Kebaikan
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- Separator -->
      <div class="flex items-center gap-3 mx-4 my-6">
        <span class="flex-1 h-px bg-neutral-200" />
        <span class="text-[10px] uppercase tracking-[0.2em] text-neutral-400 font-semibold">Ikuti Kami</span>
        <span class="flex-1 h-px bg-neutral-200" />
      </div>

      <!-- Social Media -->
      <div class="px-4 grid grid-cols-3 gap-2 mb-6">
        {socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            class="flex flex-col items-center gap-1.5 py-3 px-2 bg-white rounded-2xl shadow-sm border border-neutral-100 hover:shadow-md transition-all duration-200"
          >
            <div class="w-9 h-9 rounded-full flex items-center justify-center" style={`background-color: ${s.bg}`}>
              <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d={s.icon} />
              </svg>
            </div>
            <span class="text-[10px] font-semibold text-neutral-700 text-center leading-tight">{s.label}</span>
          </a>
        ))}
      </div>

      <!-- Footer -->
      <div class="px-4 pb-10 text-center">
        <p class="text-[11px] text-neutral-400 leading-relaxed m-0">
          &copy; {new Date().getFullYear()} Beramalbersama.com · Aksiberbagi.com<br />
          <a href="/syarat-ketentuan" class="hover:text-primary-500 transition-colors">Syarat & Ketentuan</a>
          {" · "}
          <a href="/kontak" class="hover:text-primary-500 transition-colors">Kontak</a>
        </p>
      </div>

    </div>
  </div>

</MainLayout>
