---
export const prerender = true;

import Header from "@/components/layouts/Header.astro";
import Footer from "@/components/layouts/Footer.astro";
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Kontak Kami" description="Hubungi tim Beramalbersama.com untuk pertanyaan, saran, atau bantuan seputar donasi dan program kebaikan.">
  <Header type="notshare" text="Kontak Kami" />

  <div class="container mx-auto min-h-screen bg-neutral-50 pt-[65px]">

    <!-- Hero Banner -->
    <div class="relative w-full h-40 overflow-hidden">
      <img
        src="/images/banner/kontak.webp"
        alt="Kontak Kami"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent flex items-end p-4">
        <div>
          <h1 class="text-white font-bold text-xl m-0 leading-tight">Hubungi Kami</h1>
          <p class="text-white/80 text-xs mt-1 m-0">Kami siap membantu Anda kapan saja</p>
        </div>
      </div>
    </div>

    <div class="px-4 py-6 space-y-4">

      <!-- Quick Contact Cards -->
      <div class="grid grid-cols-2 gap-3">
        <a
          href="https://api.whatsapp.com/send?phone=6281912344745&text=Assalamu%27alaikum%20Beramalbersama"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-white rounded-2xl p-4 flex flex-col items-center gap-2 shadow-sm border border-neutral-100 hover:border-primary-300 hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center group-hover:bg-green-100 transition-colors">
            <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 2.078.535 4.077 1.567 5.843L0 24l6.335-1.652A11.953 11.953 0 0012.017 24c6.624 0 11.99-5.367 11.99-11.987C24.007 5.375 18.641.009 12.017 0z"/>
            </svg>
          </div>
          <div class="text-center">
            <p class="text-xs font-semibold text-neutral-800 m-0">WhatsApp</p>
            <p class="text-[10px] text-neutral-400 m-0">Chat langsung</p>
          </div>
        </a>

        <a
          href="mailto:info@beramalbersama.com"
          class="bg-white rounded-2xl p-4 flex flex-col items-center gap-2 shadow-sm border border-neutral-100 hover:border-primary-300 hover:shadow-md transition-all duration-200 group"
        >
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center group-hover:bg-primary-100 transition-colors">
            <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="text-center">
            <p class="text-xs font-semibold text-neutral-800 m-0">Email</p>
            <p class="text-[10px] text-neutral-400 m-0">Kirim pesan</p>
          </div>
        </a>
      </div>

      <!-- Contact Info -->
      <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden">
        <div class="px-4 py-3 border-b border-neutral-100">
          <h2 class="text-sm font-bold text-neutral-800 m-0">Informasi Kontak</h2>
        </div>

        <div class="divide-y divide-neutral-100">
          <div class="flex items-center gap-3 px-4 py-3.5">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-neutral-400 m-0 uppercase tracking-wide">Telepon / WhatsApp</p>
              <p class="text-sm font-medium text-neutral-800 m-0">+62 819-1234-4745</p>
            </div>
          </div>

          <div class="flex items-center gap-3 px-4 py-3.5">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-neutral-400 m-0 uppercase tracking-wide">Email</p>
              <p class="text-sm font-medium text-neutral-800 m-0">info@beramalbersama.com</p>
            </div>
          </div>

          <div class="flex items-center gap-3 px-4 py-3.5">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-neutral-400 m-0 uppercase tracking-wide">Jam Operasional</p>
              <p class="text-sm font-medium text-neutral-800 m-0">Senin – Jumat, 08.00 – 17.00 WIB</p>
            </div>
          </div>

          <div class="flex items-start gap-3 px-4 py-3.5">
            <div class="w-8 h-8 bg-primary-50 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[10px] text-neutral-400 m-0 uppercase tracking-wide">Alamat</p>
              <p class="text-sm font-medium text-neutral-800 m-0 leading-snug">Jl. Contoh No. 123, Jakarta Selatan,<br />DKI Jakarta 12345</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Social Media -->
      <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden">
        <div class="px-4 py-3 border-b border-neutral-100">
          <h2 class="text-sm font-bold text-neutral-800 m-0">Media Sosial</h2>
        </div>
        <div class="p-4 grid grid-cols-3 gap-3">
          {[
            { label: "Instagram", handle: "@aksiberbagi", href: "https://www.instagram.com/aksiberbagi", bg: "bg-pink-50", color: "text-pink-500", icon: "M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" },
            { label: "Facebook", handle: "AksiBerbagi", href: "https://www.facebook.com/aksiberbagi", bg: "bg-blue-50", color: "text-blue-600", icon: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" },
            { label: "YouTube", handle: "@AksiBerbagi", href: "https://www.youtube.com/@aksiberbagi", bg: "bg-red-50", color: "text-red-500", icon: "M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" },
          ].map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`flex flex-col items-center gap-1.5 p-3 rounded-xl ${s.bg} hover:opacity-80 transition-opacity`}
            >
              <svg class={`w-5 h-5 ${s.color}`} fill="currentColor" viewBox="0 0 24 24">
                <path d={s.icon} />
              </svg>
              <span class="text-[10px] font-semibold text-neutral-700">{s.label}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Send Message Form -->
      <div class="bg-white rounded-2xl shadow-sm border border-neutral-100 overflow-hidden">
        <div class="px-4 py-3 border-b border-neutral-100">
          <h2 class="text-sm font-bold text-neutral-800 m-0">Kirim Pesan</h2>
          <p class="text-[11px] text-neutral-400 m-0 mt-0.5">Isi form di bawah, kami akan membalas segera</p>
        </div>
        <form id="contact-form" class="p-4 space-y-3">
          <div>
            <label class="text-xs font-medium text-neutral-600 block mb-1" for="name">Nama Lengkap</label>
            <input
              id="name"
              type="text"
              placeholder="Masukkan nama Anda"
              class="w-full h-10 px-3 rounded-xl border border-neutral-200 text-sm text-neutral-800 placeholder-neutral-300 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all"
              required
            />
          </div>
          <div>
            <label class="text-xs font-medium text-neutral-600 block mb-1" for="contact-phone">No. WhatsApp / Email</label>
            <input
              id="contact-phone"
              type="text"
              placeholder="08xx / email@..."
              class="w-full h-10 px-3 rounded-xl border border-neutral-200 text-sm text-neutral-800 placeholder-neutral-300 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all"
              required
            />
          </div>
          <div>
            <label class="text-xs font-medium text-neutral-600 block mb-1" for="message">Pesan</label>
            <textarea
              id="message"
              rows="4"
              placeholder="Tuliskan pesan atau pertanyaan Anda..."
              class="w-full px-3 py-2.5 rounded-xl border border-neutral-200 text-sm text-neutral-800 placeholder-neutral-300 focus:outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition-all resize-none"
              required
            ></textarea>
          </div>
          <button
            type="submit"
            class="w-full h-11 bg-primary-500 hover:bg-primary-600 text-white text-sm font-semibold rounded-xl transition-colors duration-200"
          >
            Kirim Pesan
          </button>
        </form>
      </div>

    </div>

    <Footer />
  </div>
</MainLayout>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (document.getElementById("name") as HTMLInputElement)?.value;
    const contact = (document.getElementById("contact-phone") as HTMLInputElement)?.value;
    const message = (document.getElementById("message") as HTMLTextAreaElement)?.value;
    const text = encodeURIComponent(`Assalamu'alaikum Beramalbersama,\n\nNama: ${name}\nKontak: ${contact}\nPesan: ${message}`);
    window.open(`https://api.whatsapp.com/send?phone=6281912344745&text=${text}`, "_blank");
  });
</script>
