---
import type { SeoProps } from "../lib/seo";
import { SITE_CONFIG } from "../lib/seo";

type Props = SeoProps;

const {
  title,
  description,
  image = SITE_CONFIG.ogImage,
  imageAlt = title,
  type = "website",
  canonical,
  robots = "index, follow",
  publishedTime,
  modifiedTime,
  author,
  locale = SITE_CONFIG.locale,
} = Astro.props;

const siteUrl = Astro.site?.href ?? "https://example.com/";
const pageUrl =
  canonical ?? (Astro.url?.href || new URL(Astro.url.pathname, Astro.site ?? siteUrl).href);
const fullTitle = `${title} | ${SITE_CONFIG.name}`;
const rawImage = image && image.trim() !== "" ? image : SITE_CONFIG.ogImage;
const ogImage = rawImage.startsWith("http") ? rawImage : new URL(rawImage, siteUrl).href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": type === "article" ? "Article" : "WebPage",
  name: title,
  description,
  url: pageUrl,
  ...(type === "article" && {
    headline: title,
    author: { "@type": "Person", name: author ?? SITE_CONFIG.name },
    datePublished: publishedTime,
    dateModified: modifiedTime ?? publishedTime,
    image: ogImage,
  }),
  isPartOf: {
    "@type": "WebSite",
    name: SITE_CONFIG.name,
    url: siteUrl,
  },
});
---

<!-- Primary Meta -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={pageUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={ogImage} />
{
  ogImage.startsWith("https://") && (
    <meta property="og:image:secure_url" content={ogImage} />
  )
}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={locale} />

<!-- Article-specific Open Graph -->
{
  type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  type === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}
{
  type === "article" && author && (
    <meta property="article:author" content={author} />
  )
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE_CONFIG.twitterHandle} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={jsonLd} />
