---
import InvoiceHelpWa from "./InvoiceHelpWa.astro";

interface Props {
  slug: string;
  eventName?: string;
  eventImage?: string;
  eventSlug?: string;
  eventWaGrup?: string | null;
}

const {
  slug,
  eventName,
  eventImage,
  eventSlug,
  eventWaGrup,
} = Astro.props;
---

<div class="min-h-screen bg-gray-50/60 pb-16 pt-20 px-4">
  <div class="max-w-[440px] mx-auto space-y-4">
    {/* Header Success Free Event */}
    <div class="bg-white rounded-2xl p-6 text-center shadow-xs border border-gray-100 flex flex-col items-center">
      <div class="relative w-20 h-20 flex items-center justify-center mb-3">
        <div class="absolute inset-0 bg-emerald-100/70 rounded-full"></div>
        <div class="relative w-12 h-12 flex items-center justify-center text-emerald-500">
          <svg class="w-full h-full drop-shadow-xs" viewBox="0 0 48 48" fill="currentColor">
            <path d="M21.2 4.4a3.8 3.8 0 0 1 5.6 0l2 2.1c1 1.1 2.5 1.7 4 1.5l2.9-.3a3.8 3.8 0 0 1 4.2 3.8l.2 2.9c.1 1.5.9 2.9 2.2 3.6l2.5 1.5a3.8 3.8 0 0 1 1.7 5.3l-1.5 2.5a4.7 4.7 0 0 0-.6 4.2l1 2.7a3.8 3.8 0 0 1-2.4 5l-2.8.9a4.7 4.7 0 0 0-3.1 3l-.9 2.8a3.8 3.8 0 0 1-4.9 2.5l-2.7-1a4.7 4.7 0 0 0-4.2.6l-2.5 1.5a3.8 3.8 0 0 1-5.3-1.7l-1.5-2.5a4.7 4.7 0 0 0-3.6-2.2l-2.9-.2a3.8 3.8 0 0 1-3.8-4.2l.3-2.9c.2-1.5-.4-3-1.5-4l-2.1-2a3.8 3.8 0 0 1 0-5.6l2.1-2c1.1-1 1.7-2.5 1.5-4l-.3-2.9a3.8 3.8 0 0 1 3.8-4.2l2.9.2c1.5.1 2.9-.9 3.6-2.2l1.5-2.5a3.8 3.8 0 0 1 5.3-1.7l2.5 1.5c1.3.8 3 .8 4.2-.6l2-2.1Z" />
          </svg>
          <svg class="w-6 h-6 text-white absolute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
      </div>

      <span class="inline-block px-2.5 py-0.5 mb-2 text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 rounded-full border border-emerald-200">
        Event Gratis
      </span>
      <h1 class="text-lg font-bold text-gray-900">Pendaftaran Diterima</h1>
      <p class="text-xs text-gray-500 mt-1 max-w-[280px]">
        Tidak ada biaya pembayaran yang diperlukan untuk mengikuti event ini.
      </p>
    </div>

    {/* Event & Registrant Details Card */}
    <div class="bg-white rounded-2xl shadow-xs border border-gray-100 divide-y divide-gray-100 text-xs">
      <div class="p-4 flex items-center justify-between">
        <div>
          <span class="text-[10px] uppercase font-medium text-gray-400 block tracking-wider">No. Registrasi</span>
          <span class="font-mono font-semibold text-gray-800">{slug}</span>
        </div>
        <div class="text-right">
          <span class="text-[10px] uppercase font-medium text-gray-400 block tracking-wider">Biaya Tiket</span>
          <span class="font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100 text-[11px]">
            Gratis (Rp 0)
          </span>
        </div>
      </div>

      {/* Event Info */}
      {eventName && (
        <div class="p-4 flex items-center gap-3">
          {eventImage ? (
            <img
              src={eventImage}
              alt={eventName}
              class="w-12 h-12 rounded-xl object-cover border border-gray-100 shrink-0"
            />
          ) : (
            <div class="w-12 h-12 rounded-xl bg-gray-50 border border-gray-100 text-gray-400 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          )}
          <div class="min-w-0 flex-1">
            <span class="text-[10px] font-semibold text-primary-600 uppercase tracking-wider block">Acara</span>
            <h2 class="text-xs font-bold text-gray-900 truncate">{eventName}</h2>
            {eventSlug && (
              <a href={`/event/${eventSlug}`} class="text-[11px] text-gray-400 hover:text-primary-600 transition-colors inline-block mt-0.5">
                Lihat detail acara &rarr;
              </a>
            )}
          </div>
        </div>
      )}

      {/* WhatsApp Group jika ada */}
      {eventWaGrup && (
        <div class="p-4 bg-emerald-50/40 flex items-start gap-3">
          <div class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="font-bold text-gray-900">Grup WhatsApp Peserta</p>
            <p class="text-[11px] text-gray-500 mt-0.5">Dapatkan info akses link acara dan koordinasi lainnya.</p>
            <a
              href={eventWaGrup}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-2 font-semibold text-emerald-600 hover:text-emerald-700 bg-white border border-emerald-200 px-3 py-1.5 rounded-lg transition-colors"
            >
              Gabung Grup &rarr;
            </a>
          </div>
        </div>
      )}

      {/* Action Buttons */}
      <div class="p-4 space-y-2 bg-gray-50/50">
        <a
          href="/event-saya"
          class="flex items-center justify-center gap-2 w-full py-3 px-4 rounded-xl bg-primary-500 hover:bg-primary-600 text-white font-semibold text-xs transition-colors shadow-xs active:scale-[0.99]"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />
          </svg>
          <span>Lihat di Event Saya</span>
        </a>

        <a
          href="/"
          class="flex items-center justify-center w-full py-2.5 px-4 rounded-xl bg-white hover:bg-gray-50 text-gray-600 font-medium text-xs border border-gray-200 transition-colors"
        >
          Jelajahi Event Lainnya
        </a>
      </div>
    </div>

    <InvoiceHelpWa text="Butuh bantuan?" />
  </div>
</div>

