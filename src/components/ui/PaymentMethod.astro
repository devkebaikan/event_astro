---
import { getServerToken } from "@/lib/auth";
const {
  paymentMethods = [],
  showWallet = true,
  showEwallet = true,
  showVa = true,
  showBank = true,
  defaultWallet = true,
} = Astro.props;

const activeMethods = (paymentMethods as any[]).filter((m: any) => {
  const status = m?.is_active;
  if (status === undefined || status === null || status === "") return true;
  return ![false, "false", 0, "0"].includes(status);
});

// TAMBAHKAN BARIS INI UNTUK MELIHAT DATA DI TERMINAL
// console.log("Data Active Methods:", activeMethods);

const walletMethod =
  activeMethods.find((m: any) => m.type === "dompet_kebaikan") ?? null;
const banks = activeMethods.filter((m: any) => m.type === "bank");
const vas = activeMethods.filter((m: any) => m.type === "virtual_account");
const ewallets = activeMethods.filter((m: any) => m.type === "e_wallet");

const isAuthenticated = getServerToken(Astro.cookies) !== null;
const walletDisplay =
  walletMethod && Object.keys(walletMethod).length > 0
    ? walletMethod
    : {
        id: 3000,
        name: "Saku Berbagi",
        image_url: "",
        type: "dompet_kebaikan",
      };

const currentPath = Astro.url.pathname + Astro.url.search;
const loginUrl = `/auth/login?from=${encodeURIComponent(currentPath)}`;
---

<div
  id="payment-modal"
  data-show-wallet={showWallet ? "true" : "false"}
  data-default-wallet={defaultWallet ? "true" : "false"}
  data-is-auth={isAuthenticated ? "true" : "false"}
  class="fixed inset-0 z-50 hidden items-center justify-center"
  aria-modal="true"
  role="dialog"
>
  <div
    id="modal-backdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-[2px]"
  >
  </div>

  <!-- <ShowJsonData data={{ wallets }} /> -->
  <!-- Bottom Sheet -->
  <div
    class="absolute max-w-110 w-full left-1/2 -translate-x-1/2 -translate-y-1/2 top-1/2 bg-white rounded-xl max-h-[80vh] shadow-2xl flex flex-col overflow-hidden"
  >
    <!-- Header -->
    <div
      class="flex items-center justify-between px-5 pt-7 pb-4 border-b border-gray-100 shrink-0"
    >
      <h3 class="text-sm font-bold text-gray-900">Pilih Metode Pembayaran</h3>
      <button
        data-close-modal
        class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 transition-colors"
        aria-label="Tutup"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Scrollable content -->
    <div class="overflow-y-auto flex-1 px-5 pb-8 pt-4 space-y-5">
      <!-- Saku Kebaikan (wallet) -->
      {
        showWallet && (
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
              Saku Kebaikan
            </p>
            <div class="space-y-2">
              {isAuthenticated ? (
                <button
                  type="button"
                  class="payment-method-item w-full flex items-center gap-3 p-3.5 border border-gray-200 rounded-lg hover:border-primary-400 hover:bg-primary-50 transition-all active:scale-[0.98]"
                  data-wallet-item="true"
                  data-id={walletDisplay.id}
                  data-name={walletDisplay.name}
                  data-image={walletDisplay.image_url}
                  data-type={walletDisplay.type}
                >
                  <div class="w-14 flex items-center justify-center shrink-0">
                    {walletDisplay.image_url ? (
                      <img
                        src={walletDisplay.image_url}
                        alt={walletDisplay.name}
                        class="h-6 w-auto object-contain"
                      />
                    ) : (
                      <div class="w-8 h-8 rounded-xl bg-primary-100 flex items-center justify-center">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          class="text-primary-600"
                        >
                          <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                          <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                          <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
                        </svg>
                      </div>
                    )}
                  </div>
                  <div class="flex-1 text-left">
                    <p class="text-sm font-medium text-gray-800">
                      {walletDisplay.name}
                    </p>
                    <p class="text-xs text-gray-400">
                      Saldo: <span id="wallet-balance-value">Rp 0</span>
                      <span id="wallet-balance-loading" class="hidden">
                        · memuat...
                      </span>
                    </p>
                  </div>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="text-gray-300 shrink-0"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              ) : (
                <div class="w-full flex items-center justify-between gap-3 p-3.5 border border-gray-200 bg-gray-50/80 rounded-lg">
                  <div class="flex items-center gap-3 min-w-0">
                    <div class="w-14 flex items-center justify-center shrink-0">
                      {walletDisplay.image_url ? (
                        <img
                          src={walletDisplay.image_url}
                          alt={walletDisplay.name}
                          class="h-6 w-auto object-contain opacity-50 grayscale"
                        />
                      ) : (
                        <div class="w-8 h-8 rounded-xl bg-gray-200 flex items-center justify-center">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="text-gray-400"
                          >
                            <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4" />
                            <path d="M3 5v14a2 2 0 0 0 2 2h16v-5" />
                            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
                          </svg>
                        </div>
                      )}
                    </div>
                    <div class="flex-1 text-left min-w-0">
                      <div class="flex items-center gap-1.5">
                        <p class="text-sm font-medium text-gray-600 truncate">
                          {walletDisplay.name}
                        </p>
                        <span class="text-[10px] font-medium bg-gray-200 text-gray-600 px-1.5 py-0.5 rounded shrink-0">
                          Perlu Login
                        </span>
                      </div>
                      <p class="text-xs text-gray-400 truncate mt-0.5">
                        Masuk untuk menggunakan saldo
                      </p>
                    </div>
                  </div>
                  <a
                    id="wallet-login-btn"
                    href={loginUrl}
                    class="text-xs font-semibold text-white bg-secondary-500 hover:bg-secondary-600 active:scale-95 px-3 py-1.5 rounded-lg transition-all shrink-0 shadow-sm"
                  >
                    Login
                  </a>
                </div>
              )}
            </div>
          </div>
        )
      }

      <!-- E-Wallet / Pembayaran Instan -->
      {
        showEwallet && ewallets.length > 0 && (
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">
              Pembayaran Instan
            </p>
            <p class="text-[11px] text-gray-400 mb-2.5">
              Konfirmasi otomatis · min. Rp10.000
            </p>
            <div class="space-y-2">
              {ewallets.map((method: any) => (
                <button
                  type="button"
                  class="payment-method-item w-full flex items-center gap-3 p-3.5 border border-gray-200 rounded-lg hover:border-primary-400 hover:bg-primary-50 transition-all active:scale-[0.98]"
                  data-id={method.id}
                  data-name={method.name}
                  data-image={method.image_url}
                  data-type={method.type}
                >
                  <div class="w-14 flex items-center justify-center shrink-0">
                    <img
                      src={method.image_url}
                      alt={method.name}
                      class="h-6 w-auto object-contain"
                    />
                  </div>
                  <span class="flex-1 text-left text-xs md:text-sm font-medium text-gray-800">
                    {method.name}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="text-gray-300 shrink-0"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              ))}
            </div>
          </div>
        )
      }

      <!-- Virtual Account -->
      {
        showVa && vas.length > 0 && (
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">
              Virtual Account
            </p>
            <p class="text-[11px] text-gray-400 mb-2.5">
              Konfirmasi otomatis · min. Rp10.000
            </p>
            <div class="space-y-2">
              {vas.map((method: any) => (
                <button
                  type="button"
                  class="payment-method-item w-full flex items-center gap-3 p-3.5 border border-gray-200 rounded-lg hover:border-primary-400 hover:bg-primary-50 transition-all active:scale-[0.98]"
                  data-id={method.id}
                  data-name={method.name}
                  data-image={method.image_url}
                  data-type={method.type}
                >
                  <div class="w-14 flex items-center justify-center shrink-0">
                    <img
                      src={method.image_url}
                      alt={method.name}
                      class="h-6 w-auto object-contain"
                    />
                  </div>
                  <span class="flex-1 text-left text-xs md:text-sm font-medium text-gray-800">
                    {method.name}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="text-gray-300 shrink-0"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              ))}
            </div>
          </div>
        )
      }

      <!-- Transfer Bank -->
      {
        showBank && banks.length > 0 && (
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">
              Transfer Bank
            </p>
            <p class="text-[11px] text-gray-400 mb-2.5">
              Verifikasi manual 1×24 jam · min. Rp10.000
            </p>
            <div class="space-y-2">
              {banks.map((method: any) => (
                <button
                  type="button"
                  class="payment-method-item w-full flex items-center gap-3 p-3.5 border border-gray-200 rounded-lg hover:border-primary-400 hover:bg-primary-50 transition-all active:scale-[0.98]"
                  data-id={method.id}
                  data-name={method.name}
                  data-image={method.image_url}
                  data-type={method.type}
                >
                  <div class="w-14 flex items-center justify-center shrink-0">
                    <img
                      src={method.image_url}
                      alt={method.name}
                      class="h-6 w-auto object-contain"
                    />
                  </div>
                  <span class="flex-1 text-left text-xs md:text-sm font-medium text-gray-800">
                    {method.name}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="text-gray-300 shrink-0"
                  >
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  import { bearerHeaders, getToken, isLoggedIn } from "@/lib/auth";
  import { formatRupiah } from "@/lib/formatter";

  const modal = document.getElementById("payment-modal");
  if (!modal) throw new Error("payment-modal not found");

  const backdrop = document.getElementById("modal-backdrop");
  const walletItem = modal.querySelector<HTMLElement>(
    '[data-wallet-item="true"]',
  );
  const walletBalanceValue = document.getElementById("wallet-balance-value");
  const walletBalanceLoading = document.getElementById(
    "wallet-balance-loading",
  );

  const isAuth = modal?.dataset.isAuth === "true" || isLoggedIn();
  const shouldDefaultWallet = isAuth && modal?.dataset.defaultWallet === "true";

  const guestWalletLoginBtn =
    modal.querySelector<HTMLAnchorElement>("#wallet-login-btn");
  if (guestWalletLoginBtn && typeof window !== "undefined") {
    guestWalletLoginBtn.href = `/auth/login?from=${encodeURIComponent(
      window.location.pathname + window.location.search,
    )}`;
  }

  let walletFetched = false;
  let walletFetching = false;

  function getCachedSaldo(): number {
    const raw = localStorage.getItem("saldo");
    const value = Number(raw ?? 0);
    return Number.isFinite(value) ? value : 0;
  }

  function renderWalletBalance(saldo: number, loading = false) {
    if (walletBalanceValue) {
      walletBalanceValue.textContent = formatRupiah(saldo);
    }
    walletBalanceLoading?.classList.toggle("hidden", !loading);
  }

  if (isLoggedIn()) {
    renderWalletBalance(getCachedSaldo(), false);
  }

  async function fetchWalletBalance() {
    if (!walletItem || walletFetched || walletFetching) return;
    if (!isLoggedIn()) return;

    const token = getToken();
    if (!token) return;

    walletFetching = true;
    renderWalletBalance(getCachedSaldo(), true);

    try {
      const res = await fetch(`/api/dashboard/donatur/my-wallet`, {
        headers: bearerHeaders(token),
      });
      if (!res.ok) return;

      const json = await res.json();
      const data = json?.data ?? {};

      // dukung 2 format lama/baru:
      // baru: { data: { saldo, history } }
      // lama: { data: { dompet_kebaikan: { saldo } } }
      const saldo = Number(data?.saldo ?? data?.dompet_kebaikan?.saldo ?? 0);
      localStorage.setItem("saldo", String(saldo));
      renderWalletBalance(saldo, false);
      walletFetched = true;
    } catch {
      renderWalletBalance(getCachedSaldo(), false);
    } finally {
      walletFetching = false;
    }
  }

  function closeModal() {
    modal!.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function openModal() {
    modal!.classList.remove("hidden");
    document.body.style.overflow = "hidden";
    if (guestWalletLoginBtn) {
      guestWalletLoginBtn.href = `/auth/login?from=${encodeURIComponent(
        window.location.pathname + window.location.search,
      )}`;
    }
    void fetchWalletBalance();
  }

  function emitSelected(item: HTMLElement) {
    window.dispatchEvent(
      new CustomEvent("payment:selected", {
        detail: {
          id: Number(item.dataset.id),
          name: item.dataset.name,
          image: item.dataset.image,
          type: item.dataset.type,
        },
      }),
    );
  }

  backdrop?.addEventListener("click", closeModal);

  modal.querySelectorAll("[data-close-modal]").forEach((btn) => {
    btn.addEventListener("click", closeModal);
  });

  (window as any).openPaymentModal = openModal;

  modal
    .querySelectorAll<HTMLElement>(".payment-method-item")
    .forEach((item) => {
      item.addEventListener("click", () => {
        emitSelected(item);
        closeModal();
      });
    });

  if (shouldDefaultWallet && walletItem) {
    emitSelected(walletItem);
  }
</script>
