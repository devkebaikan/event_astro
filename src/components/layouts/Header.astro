---
// Header.astro
interface Props {
  type?: 'default' | 'title' | 'search' | 'onlytext' | 'notshare' | 'onlyicon';
  text?: string;
  link?: string;
}

const { type = 'default', text = '', link = '' } = Astro.props;

const logo_white = '/assets/logo/logo-long-white.png';
const logo_short_white = '/assets/logo/logo-short-white.png';

const navItems = [
  {
    href: '/tentang',
    label: 'Tentang Kami',
    desc: 'Profil & visi misi Beramalbersama',
    icon: 'info',
  },
  {
    href: '/kontak',
    label: 'Hubungi Kami',
    desc: 'Layanan donatur & informasi',
    icon: 'phone',
  },
  {
    href: '/rekening',
    label: 'Rekening Donasi',
    desc: 'Daftar rekening resmi',
    icon: 'card',
  },
  {
    href: '/syarat-ketentuan',
    label: 'Syarat & Ketentuan',
    desc: 'Ketentuan & kebijakan privasi',
    icon: 'document',
  },
];
---

{type === 'default' && (
  <header id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
    <div class="container px-2 md:px-4">
      <div class="flex items-center justify-between h-[65px] gap-2">
        <!-- Logo -->
        <a
          class="flex-shrink-0 h-[34px] overflow-hidden transition-transform duration-300 hover:scale-[1.02]"
          href="/"
        >
          <img
            src={logo_white}
            alt="brand_logo"
            class="h-full w-auto hidden md:block object-contain"
          />
          <img
            src={logo_short_white}
            alt="brand_logo"
            class="h-full w-auto block md:hidden object-contain"
          />
        </a>

        <!-- Search Bar -->
        <div class="flex-1 ml-2 md:ml-4 max-w-2xl">
          <div id="search-container" class="hidden">
            <form id="search-form" class="relative">
              <input
                type="text"
                id="search-input"
                class="w-full h-9 md:h-10 pl-4 pr-12 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50 focus:bg-white/25 transition-all duration-300"
                placeholder="Cari program kebaikan..."
              />
              <button
                type="submit"
                class="absolute right-1 top-1/2 -translate-y-1/2 h-8 w-8 md:h-9 md:w-9 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/30 transition-colors duration-200"
                aria-label="Cari"
              >
                <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
                </svg>
              </button>
            </form>
          </div>

          <button
            id="search-button"
            class="w-full h-9 md:h-10 px-4 rounded-full bg-white/15 backdrop-blur-md border border-white/20 hover:bg-white/20 hover:border-white/30 transition-all duration-300 flex items-center gap-3 group text-left"
          >
            <svg class="w-4 h-4 md:w-5 md:h-5 text-white/80 group-hover:text-white transition-colors shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
            </svg>
            <span id="typing-text" class="text-xs sm:text-sm md:text-base text-white truncate">Cari Program Kebaikan...</span>
          </button>
        </div>

        <!-- Menu Toggle Button (Hamburger) -->
        <button
          id="menu-toggle"
          class="flex-shrink-0 flex w-9 h-9 md:w-10 md:h-10 items-center justify-center rounded-full bg-white/15 backdrop-blur-md border border-white/20 hover:bg-white/25 active:scale-95 hover:scale-105 transition-all duration-300 group cursor-pointer"
          aria-label="Toggle menu"
        >
          <svg id="menu-icon" class="w-5 h-5 md:w-6 md:h-6 text-white group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="close-icon" class="w-5 h-5 md:w-6 md:h-6 text-white group-hover:rotate-90 transition-transform duration-300 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation Menu Dropdown -->
    <div id="nav-menu" class="overflow-hidden transition-all duration-300 ease-in-out max-h-0 opacity-0">
      <div class="bg-primary-600/95 backdrop-blur-xl border-t border-white/15 shadow-2xl">
        <div class="container mx-auto px-3 py-3">
          <div class="grid grid-cols-1 gap-1.5 max-h-[70vh] overflow-y-auto pr-1">
            {navItems.map((item) => (
              <a
                href={item.href}
                class="flex items-center justify-between p-2.5 rounded-xl text-white bg-white/5 hover:bg-white/15 border border-white/10 hover:border-white/25 transition-all duration-200 group"
              >
                <div class="flex items-center gap-3">
                  <div class="flex flex-col text-left">
                    <span class="text-xs sm:text-sm font-semibold text-white group-hover:text-white leading-tight">{item.label}</span>
                    <span class="text-[10px] sm:text-[11px] text-white/70 line-clamp-1 mt-0.5">{item.desc}</span>
                  </div>
                </div>
                <svg class="text-white/60 group-hover:text-white group-hover:translate-x-0.5 transition-all w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
                </svg>
              </a>
            ))}
          </div>

          <!-- Login Button (conditionally shown) -->
          <div id="login-section" class="hidden mt-3 pt-2.5 border-t border-white/15">
            <a
              href={`/auth/login?from=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`}
              class="flex items-center gap-3 justify-center w-full text-center bg-white text-primary-600 font-semibold py-2.5 rounded-xl shadow-md hover:bg-neutral-50 transition text-sm"
            >
              Masuk Akun
              <span>
              <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 32 32">
                <path d="M0 0h32v32H0z" fill="none" />
                <path fill="currentColor" d="M26 30H14a2 2 0 0 1-2-2v-3h2v3h12V4H14v3h-2V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v24a2 2 0 0 1-2 2" />
                <path fill="currentColor" d="M14.59 20.59L18.17 17H4v-2h14.17l-3.58-3.59L16 10l6 6l-6 6z" />
              </svg>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </header>
)}

{type === 'onlyicon' && (
  <header class="fixed top-0 left-0 right-0 z-50 bg-primary-500 shadow-md">
    <div class="container mx-auto px-4 h-[65px] flex items-center justify-between">
       <!-- Logo -->
        <a
          class="flex-shrink-0 h-[34px] transition-transform duration-300 hover:scale-[1.02]"
          href="/"
        >
          <img
            alt="brand_logo"
            class="h-full w-auto object-contain"
            src={logo_white}
            height={40}
          />
        </a>
      
      <button
        id="share-button"
        class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors"
      >
        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
          <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"></path>
        </svg>
      </button>
    </div>
  </header>
)}

{type === 'title' && (
  <header id="header-transparent" class="fixed top-0 left-0 right-0 z-50 bg-transparent text-primary-600">
    <div class="container mx-auto px-4 h-[65px] flex items-center justify-between">
      <button
        id="back-button"
        data-link={link}
        class="w-10 h-10 flex items-center justify-center rounded-full bg-white/80 hover:bg-white/10 transition-colors"
      >
        <svg class="w-6 h-6 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <h2 id="text-header" class="text-[16px] hidden leading-[19px] my-0 font-semibold flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-start px-4">
        {text}
      </h2>
      
      <button
        id="share-button"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-white/80 hover:bg-white/10 transition-colors"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"></path>
        </svg>
      </button>
    </div>
  </header>
)}

{type === 'search' && (
  <header class="fixed top-0 left-0 right-0 z-50 bg-primary-500 border-b border-gray-100 shadow-sm">
    <div class="max-w-120 mx-auto px-3 h-[65px] flex items-center gap-2">
      <!-- Back -->
      <button
        id="search-back-btn"
        class="shrink-0 w-9 h-9 flex items-center justify-center rounded-full text-white hover:bg-white/20 transition-colors"
        aria-label="Kembali"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>

      <!-- Search form -->
      <form id="donasi-search-form" class="flex-1 relative">
        <svg
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z"
            clip-rule="evenodd"></path>
        </svg>
        <input
          id="donasi-search-input"
          type="search"
          value={text}
          placeholder="Cari program donasi..."
          autocomplete="off"
          class="w-full h-10 pl-9 pr-10 rounded-xl bg-gray-100 border border-transparent
                 text-sm text-gray-800 placeholder-gray-400
                 focus:bg-white focus:border-primary-300 focus:ring-2 focus:ring-primary-100
                 outline-none transition-all"
        />
        <!-- Clear button -->
        <button
          type="button"
          id="donasi-search-clear"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-6 h-6 hidden
                 items-center justify-center rounded-full bg-gray-400
                 hover:bg-gray-500 transition-colors"
          aria-label="Hapus pencarian"
        >
          <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L10 11.414l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"></path>
          </svg>
        </button>
      </form>
    </div>
  </header>
)}

{type === 'notshare' && (
 <header id="header-transparent" class="fixed top-0 left-0 right-0 z-50 bg-transparent text-primary-600">
    <div class="container mx-auto px-4 h-[65px] flex items-center justify-between">
      <button
        id="back-button"
        data-link={link}
        class="w-10 h-10 flex items-center justify-center rounded-full bg-white/80 hover:bg-white/10 transition-colors"
      >
        <svg class="w-6 h-6 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      
      <h2 id="text-header" class="text-[16px] hidden leading-[19px] my-0 font-semibold flex-1 overflow-hidden text-ellipsis whitespace-nowrap text-start px-4">
        {text}
      </h2>
      
      <button
        id="share-button"
        class="w-10 h-10 flex items-center justify-center rounded-full bg-white/80 hover:bg-white/10 transition-colors hidden"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
          <path d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"></path>
        </svg>
      </button>
    </div>
  </header>
)}

<script>
  import { appendReffCodeToUrl } from "@/lib/referral";
  import { showToast } from "@/lib/toast";

  function setupHeader() {
    const $ = (id: string) => document.getElementById(id);

    const mainHeader = $("main-header");
    const header = $("header-transparent");
    const backButton = $("back-button");
    const shareButton = $("share-button");
    const textHeader = $("text-header");

    const menuToggle = $("menu-toggle");
    const navMenu = $("nav-menu");
    const menuIcon = $("menu-icon");
    const closeIcon = $("close-icon");

    const searchContainer = $("search-container");
    const searchButton = $("search-button");
    const searchForm = $("search-form");

    const typingText = $("typing-text");
    const loginSection = $("login-section");

    // ========================
    // Scroll Effect (optimized)
    // ========================
    let ticking = false;

    function handleHeaderState() {
      const scrolled = window.scrollY > 20;
      const isMenuOpen = navMenu?.classList.contains("max-h-[800px]");

      if (mainHeader) {
        const isSolid = scrolled || isMenuOpen;
        mainHeader.classList.toggle("bg-transparent", !isSolid);
        mainHeader.classList.toggle("bg-primary-500", isSolid);
        mainHeader.classList.toggle("shadow-lg", isSolid);
        mainHeader.classList.toggle("backdrop-blur-sm", isSolid);
      }

      if (header && backButton && shareButton && textHeader) {
        header.classList.toggle("bg-transparent", !scrolled);
        header.classList.toggle("bg-primary-500", scrolled);
        header.classList.toggle("shadow-lg", scrolled);
        header.classList.toggle("backdrop-blur-sm", scrolled);
        header.classList.toggle("text-white", scrolled);
        header.classList.toggle("text-primary-600", !scrolled);

        backButton.classList.toggle("bg-white/80", !scrolled);
        shareButton.classList.toggle("bg-white/80", !scrolled);

        textHeader.classList.toggle("inline-block", scrolled);
      }

      ticking = false;
    }

    window.addEventListener("scroll", () => {
      if (!ticking) {
        window.requestAnimationFrame(handleHeaderState);
        ticking = true;
      }
    });

    // ========================
    // Back Button
    // ========================
    backButton?.addEventListener("click", () => {
      const link = backButton.dataset.link;
      link ? (window.location.href = link) : window.history.back();
    });

    // ========================
    // Share Button
    // ========================
    shareButton?.addEventListener("click", async () => {
      const shareUrl = await appendReffCodeToUrl(window.location.href);

      try {
        if (navigator.share) {
          await navigator.share({
            title: document.title,
            url: shareUrl,
          });
        } else {
          await navigator.clipboard.writeText(shareUrl);
          showToast("Link berhasil disalin!", "success");
        }
      } catch (err) {
        console.error("Share error:", err);
      }
    });

    // ========================
    // Menu Toggle
    // ========================
    function toggleMenu(forceClose?: boolean) {
      if (!navMenu) return;
      const isOpen = navMenu.classList.contains("max-h-[800px]");
      const shouldOpen = forceClose !== undefined ? !forceClose : !isOpen;

      navMenu.classList.toggle("max-h-[800px]", shouldOpen);
      navMenu.classList.toggle("opacity-100", shouldOpen);
      navMenu.classList.toggle("max-h-0", !shouldOpen);
      navMenu.classList.toggle("opacity-0", !shouldOpen);

      menuIcon?.classList.toggle("hidden", shouldOpen);
      closeIcon?.classList.toggle("hidden", !shouldOpen);

      // close search if opening menu
      if (shouldOpen && searchContainer && !searchContainer.classList.contains("hidden")) {
        searchContainer.classList.add("hidden");
        searchButton?.classList.remove("hidden");
      }

      handleHeaderState();
    }

    menuToggle?.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Click outside menu to close
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement | null;
      if (
        navMenu &&
        menuToggle &&
        target &&
        !navMenu.contains(target) &&
        !menuToggle.contains(target) &&
        navMenu.classList.contains("max-h-[800px]")
      ) {
        toggleMenu(true);
      }
    });

    // ========================
    // Search Toggle
    // ========================
    searchButton?.addEventListener("click", (e) => {
      e.stopPropagation();
      searchButton.classList.add("hidden");
      searchContainer?.classList.remove("hidden");

      const input = $("search-input");
      input?.focus();

      // close menu if open
      if (navMenu?.classList.contains("max-h-[800px]")) {
        toggleMenu(true);
      }
    });

    // click outside search
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (
        searchContainer &&
        searchButton &&
        target instanceof HTMLElement &&
        !searchContainer.contains(target) &&
        !searchButton.contains(target)
      ) {
        searchContainer.classList.add("hidden");
        searchButton.classList.remove("hidden");
      }
    });

    // ========================
    // Search Submit (default header)
    // ========================
    searchForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = $("search-input");
      const query = (input as HTMLInputElement)?.value.trim();
      if (query) {
        window.location.href = `/donasi/?q=${encodeURIComponent(query)}`;
      }
    });

    // ========================
    // Search Header (type="search")
    // ========================
    const donasiSearchForm = document.getElementById("donasi-search-form");
    const donasiSearchInput = document.getElementById("donasi-search-input") as HTMLInputElement | null;
    const donasiSearchClear = document.getElementById("donasi-search-clear");
    const searchBackBtn = document.getElementById("search-back-btn");

    function updateClearBtn() {
      if (!donasiSearchInput || !donasiSearchClear) return;
      const hasValue = donasiSearchInput.value.trim() !== "";
      donasiSearchClear.classList.toggle("hidden", !hasValue);
      donasiSearchClear.classList.toggle("flex", hasValue);
    }

    if (donasiSearchInput) {
      updateClearBtn();
      donasiSearchInput.addEventListener("input", updateClearBtn);
      // auto-focus jika tidak ada query (user baru buka halaman pencarian)
      if (!donasiSearchInput.value) {
        donasiSearchInput.focus();
      }
    }

    donasiSearchClear?.addEventListener("click", () => {
      if (!donasiSearchInput) return;
      donasiSearchInput.value = "";
      updateClearBtn();
      donasiSearchInput.focus();
    });

    donasiSearchForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const query = donasiSearchInput?.value.trim() ?? "";
      window.location.href = query
        ? `/donasi/?q=${encodeURIComponent(query)}`
        : "/donasi/";
    });

    searchBackBtn?.addEventListener("click", () => {
      if (document.referrer) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });

    // ========================
    // Typing Animation
    // ========================
    if (typingText) {
      const texts = [
        "Cari Program Keb...",
        "Bangun Masjid...",
        "Pondok Quran...",
        "Pendidikan Quran...",
      ];

      let textIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      function type() {
        if (!typingText) return;
        const current = texts[textIndex];

        typingText.textContent = isDeleting
          ? current.substring(0, charIndex--)
          : current.substring(0, charIndex++);

        if (!isDeleting && charIndex === current.length) {
          isDeleting = true;
          setTimeout(type, 2000);
          return;
        }

        if (isDeleting && charIndex === 0) {
          isDeleting = false;
          textIndex = (textIndex + 1) % texts.length;
        }

        setTimeout(type, isDeleting ? 50 : 100);
      }

      type();
    }

    // ========================
    // Auth Check
    // ========================
    if (loginSection) {
      import("@/lib/auth").then(({ isLoggedIn }) => {
        loginSection.classList.toggle("hidden", isLoggedIn());
      });
    }
  }

  // Support standard DOM and Astro page-load lifecycle
  document.addEventListener("DOMContentLoaded", setupHeader);
  document.addEventListener("astro:page-load", setupHeader);
</script>

