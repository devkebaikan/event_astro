---
interface Props {
  active?: "home" | "program" | "donasiku" | "rutin" | "akun";
}
const { active = "home" } = Astro.props;

const items = [
  { id: "home", href: "/", label: "Beranda" },
  { id: "program", href: "/donasi", label: "Program" },
  { id: "donasiku", href: "/donasi-saya", label: "Donasiku" },
  { id: "rutin", href: "/donasi-rutin", label: "Rutin" },
  { id: "akun", href: "/akun", label: "Akun" },
] as const;
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-neutral-200"
  style="box-shadow: 0 -2px 12px rgba(0,0,0,0.06);"
>
  <div class="container">
    <div class="grid grid-cols-5 h-[60px]">
      {
        items.map((item) => {
          const on = item.id === active;
          return (
            <a
              href={item.href}
              class={`flex flex-col items-center justify-center gap-0.5 transition-colors duration-150 ${on ? "text-primary-500" : "text-neutral-400 hover:text-neutral-500"}`}
              aria-current={on ? "page" : undefined}
            >
              {item.id === "home" && (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill={on ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.75"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 22V12h6v10"
                  />
                </svg>
              )}
              {item.id === "program" && (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill={on ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.75"
                >
                  <rect
                    x="3"
                    y="3"
                    width="7"
                    height="7"
                    rx="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="14"
                    y="3"
                    width="7"
                    height="7"
                    rx="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="3"
                    y="14"
                    width="7"
                    height="7"
                    rx="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="14"
                    y="14"
                    width="7"
                    height="7"
                    rx="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              )}
              {item.id === "donasiku" && (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill={on ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.75"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                  />
                </svg>
              )}
              {item.id === "rutin" && (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill={on ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.75"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                  />
                </svg>
              )}
              {item.id === "akun" && (
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill={on ? "currentColor" : "none"}
                  stroke="currentColor"
                  stroke-width="1.75"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
              )}
              <span class="text-[10px] font-medium leading-none">
                {item.label}
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</nav>
