---
interface Props {
  active?: "home" | "event-saya" | "akun";
}

const { active = "home" } = Astro.props;

const items = [
  { id: "home", href: "/", label: "Home" },
  { id: "event-saya", href: "/event-saya", label: "Event Saya" },
  { id: "akun", href: "/akun", label: "Akun" },
] as const;
---

<nav
  aria-label="Navigasi Utama"
  class="fixed bottom-5 left-1/2 -translate-x-1/2 z-50"
>
  <div
    class="flex items-center gap-1.5 p-1.5 rounded-full
         bg-primary-300/80 backdrop-blur-2xl backdrop-saturate-150
         border border-white/40
         shadow-[0_8px_32px_rgba(0,0,0,0.12)]
         ring-1 ring-white/20"
  >
    {
      items.map((item) => {
        const isActive = item.id === active;
        return (
          <a
            href={item.href}
            class={`group flex items-center justify-center transition-all duration-300 ease-out select-none ${
              isActive
                ? "bg-white text-neutral-900 shadow-sm shadow-black/10 border border-white rounded-full px-6 py-2.5 gap-2 font-semibold text-sm"
                : "w-10 h-10 rounded-full text-neutral-500 hover:text-neutral-700 hover:bg-white/50 active:scale-95"
            }`}
            aria-current={isActive ? "page" : undefined}
            title={item.label}
          >
            {item.id === "home" && (
              <svg
                class="w-5 h-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 10.5L12 3l9 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 19.5v-9z" />
                <path d="M9 22v-6a3 3 0 0 1 6 0v6" />
              </svg>
            )}

            {item.id === "event-saya" && (
              <svg
                class="w-5 h-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                <path d="M7.5 9l1 1 2-2" />
                <path d="M13.5 9h3" />
                <path d="M7.5 15l1 1 2-2" />
                <path d="M13.5 15h3" />
              </svg>
            )}

            {item.id === "akun" && (
              <svg
                class="w-5 h-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            )}

            {isActive && (
              <span class="text-sm font-semibold tracking-tight whitespace-nowrap">
                {item.label}
              </span>
            )}
          </a>
        );
      })
    }
  </div>
</nav>
